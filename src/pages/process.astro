---
import BaseLayout from '../layouts/BaseLayout.astro';
import FdProcessHero from '../components/sections/FdProcessHero.astro';
import FdProcess from '../components/sections/FdProcess.astro';
import FdFaq from '../components/sections/FdFaq.astro';
import FdCta from '../components/sections/FdCta.astro';
import { defaultLang } from '../i18n/languages';
import { getCopy } from '../i18n/copy';
import { getRoutePath } from '../i18n/routes';
import { buildFaqSchema } from '../data/faq-schema';
const lang = defaultLang;
const copy = getCopy(lang);
---

<BaseLayout
  lang={lang}
  title={copy.pages.process.meta.title}
  description={copy.pages.process.meta.description}
  structuredData={buildFaqSchema(lang)}
>
  <FdProcessHero
    lang={lang}
    eyebrow={copy.pages.process.hero.eyebrow}
    title={copy.pages.process.hero.title}
    subtitle={copy.pages.process.hero.subtitle}
    primaryLabel={copy.pages.process.hero.primaryLabel}
    primaryHref={getRoutePath('contact', lang)}
    secondaryLabel={copy.pages.process.hero.secondaryLabel}
    secondaryHref={getRoutePath('services', lang)}
  />
  <FdProcess lang={lang} />
  <FdFaq lang={lang} />
  <FdCta lang={lang} />
</BaseLayout>

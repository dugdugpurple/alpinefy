---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import Container from '../components/Container.astro';
import SectionHeading from '../components/SectionHeading.astro';
import { attributionFieldNames, getContactIntakeCopy } from '../data/contact-intake';
import { getDisplayPhone, getPhoneDialValue, site } from '../data/site';
import { defaultLang } from '../i18n/languages';
import { getCopy } from '../i18n/copy';
import { getRoutePath } from '../i18n/routes';
const lang = defaultLang;
const copy = getCopy(lang);
const contactFormName = 'contact-inquiry';
const currentPath = Astro.url.pathname;
const phoneLabel = getDisplayPhone(lang);
const phoneDial = getPhoneDialValue();
const intake = getContactIntakeCopy(lang);
---

<BaseLayout
  lang={lang}
  title={copy.pages.contact.meta.title}
  description={copy.pages.contact.meta.description}
>
  <Hero
    lang={lang}
    eyebrow={copy.pages.contact.hero.eyebrow}
    title={copy.pages.contact.hero.title}
    subtitle={copy.pages.contact.hero.subtitle}
    primaryLabel={copy.pages.contact.hero.primaryLabel}
    primaryHref={`mailto:${site.email}`}
    secondaryLabel={copy.pages.contact.hero.secondaryLabel}
    secondaryHref={getRoutePath('services', lang)}
  />

  <section class="py-20 sm:py-24">
    <Container class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr]">
      <div class="space-y-8" id="kontakt-formular">
        <SectionHeading
          eyebrow={copy.pages.contact.formHeading.eyebrow}
          title={copy.pages.contact.formHeading.title}
          subtitle={copy.pages.contact.formHeading.subtitle}
        />
        <form
          class="grid gap-4"
          name={contactFormName}
          method="POST"
          netlify
          netlify-honeypot="bot-field"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          data-capture-attribution="true"
          action={`${getRoutePath('thankYou', lang)}?src=contact&lang=${lang}`}
        >
          <input type="hidden" name="form-name" value={contactFormName} />
          <p class="hidden">
            <label>
              Don’t fill this out if you’re human: <input name="bot-field" />
            </label>
          </p>
          <input type="hidden" name="recipient" value={site.email} />
          <input type="hidden" name="subject" value="New qualified contact inquiry" />
          <input type="hidden" name="locale" value={lang} />
          <input type="hidden" name="source_page" value={currentPath} />
          {attributionFieldNames.map((field) => (
            <input type="hidden" name={field} value="" data-attribution-field={field} />
          ))}
          <label class="grid gap-2 text-sm text-mist">
            {copy.pages.contact.formLabels.name}
            <input
              class="input-field"
              name="meno"
              placeholder={copy.pages.contact.formLabels.namePlaceholder}
              required
            />
          </label>
          <label class="grid gap-2 text-sm text-mist">
            {copy.pages.contact.formLabels.email}
            <input
              class="input-field"
              name="email"
              type="email"
              placeholder={copy.pages.contact.formLabels.emailPlaceholder}
              required
            />
          </label>
          <div class="grid gap-4 sm:grid-cols-2">
            <label class="grid gap-2 text-sm text-mist">
              {intake.serviceLabel}
              <select class="input-field" name="service_interest" required>
                <option value="" selected disabled>{intake.servicePlaceholder}</option>
                {intake.serviceOptions.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </label>
            <label class="grid gap-2 text-sm text-mist">
              {intake.budgetLabel}
              <select class="input-field" name="budget_range" required>
                <option value="" selected disabled>{intake.budgetPlaceholder}</option>
                {intake.budgetOptions.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </label>
          </div>
          <label class="grid gap-2 text-sm text-mist">
            {intake.timelineLabel}
            <select class="input-field" name="timeline_preference" required>
              <option value="" selected disabled>{intake.timelinePlaceholder}</option>
              {intake.timelineOptions.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </label>
          <label class="grid gap-2 text-sm text-mist">
            {intake.websiteLabel}
            <input
              class="input-field"
              name="current_website"
              type="url"
              inputmode="url"
              placeholder={intake.websitePlaceholder}
            />
          </label>
          <label class="grid gap-2 text-sm text-mist">
            {copy.pages.contact.formLabels.message}
            <textarea
              class="input-field min-h-[140px]"
              name="sprava"
              placeholder={copy.pages.contact.formLabels.messagePlaceholder}
              required
            ></textarea>
          </label>
          <button class="btn-primary w-full sm:w-auto" type="submit">{copy.pages.contact.formLabels.submit}</button>
          <p class="text-xs text-mist">{copy.pages.contact.formLabels.consent}</p>
        </form>
      </div>

      <div class="space-y-6">
        <SectionHeading
          eyebrow={copy.pages.contact.directHeading.eyebrow}
          title={copy.pages.contact.directHeading.title}
          subtitle={copy.pages.contact.directHeading.subtitle}
        />
        <div class="card space-y-4">
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-aqua/80">{copy.pages.contact.directLabels.email}</p>
            <a class="mt-2 block text-lg text-ice" href={`mailto:${site.email}`}>{site.email}</a>
          </div>
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-aqua/80">{copy.pages.contact.directLabels.phone}</p>
            <a class="mt-2 block text-lg text-ice" href={`tel:${phoneDial}`}>
              {phoneLabel}
            </a>
          </div>
          <div>
            <p class="text-xs uppercase tracking-[0.3em] text-aqua/80">{copy.pages.contact.directLabels.location}</p>
            <p class="mt-2 text-sm text-mist">{site.address}</p>
          </div>
        </div>
        <div class="card">
          <p class="text-xs uppercase tracking-[0.3em] text-aqua/80">{copy.pages.contact.directLabels.scope}</p>
          <p class="mt-3 text-sm text-mist">{copy.pages.contact.directLabels.scopeText}</p>
        </div>
      </div>
    </Container>
  </section>
</BaseLayout>

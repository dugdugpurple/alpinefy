---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';
import { getBlogPosts } from '../../i18n/blog';
import { localizePath } from '../../i18n/utils';

const lang = defaultLang;
const copy = getCopy(lang);
const posts = getBlogPosts(lang);
const localeByLang = {
  en: 'en-US',
  de: 'de-DE',
  pl: 'pl-PL',
  cz: 'cs-CZ',
  sk: 'sk-SK',
};
const formatDate = (date: string) =>
  new Intl.DateTimeFormat(localeByLang[lang] ?? 'en-US', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(date));
---

<BaseLayout
  lang={lang}
  title={copy.pages.blog.meta.title}
  description={copy.pages.blog.meta.description}
>
  <section class="pt-28 pb-12 sm:pt-32 sm:pb-14">
    <Container class="max-w-[1120px] space-y-6">
      <p class="text-xs font-semibold uppercase tracking-[0.32em] text-aqua/88">{copy.pages.blog.hero.eyebrow}</p>
      <h1 class="max-w-4xl font-display text-4xl leading-[1.03] sm:text-5xl lg:text-6xl">
        {copy.pages.blog.hero.title}
      </h1>
      <p class="max-w-2xl text-base text-mist sm:text-lg">{copy.pages.blog.hero.subtitle}</p>
    </Container>
  </section>

  <div class="border-t border-white/10"></div>

  <section class="py-4 sm:py-6">
    <Container class="max-w-[1120px]">
      <div class="divide-y divide-white/10">
        {posts.map((post) => (
          <article class="group grid gap-5 py-8 md:grid-cols-[1fr_auto] md:items-end">
            <div class="max-w-3xl space-y-3">
              <p class="text-[11px] uppercase tracking-[0.24em] text-aqua/82">
                {post.category} · {formatDate(post.date)} · {post.readingTime}
              </p>
              <h2 class="font-display text-2xl leading-tight sm:text-3xl">
                <a
                  class="transition group-hover:text-aqua"
                  href={`${localizePath('/blog', lang)}/${post.slug}`}
                >
                  {post.title}
                </a>
              </h2>
              <p class="text-sm text-mist sm:text-base">{post.excerpt}</p>
            </div>
            <a
              class="inline-flex text-sm font-semibold text-aqua transition hover:text-ice"
              href={`${localizePath('/blog', lang)}/${post.slug}`}
            >
              {copy.pages.blog.readMoreLabel} →
            </a>
          </article>
        ))}
      </div>
    </Container>
  </section>
</BaseLayout>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';
import { getBlogPosts } from '../../i18n/blog';
import { getBlogImageMeta } from '../../i18n/blogImages';
import { localizePath } from '../../i18n/utils';

const lang = defaultLang;
const copy = getCopy(lang);
const posts = getBlogPosts(lang);
const categoryTitleByLang = {
  en: 'Categories',
  de: 'Kategorien',
  pl: 'Kategorie',
  cz: 'Kategorie',
  sk: 'Kategórie',
} as const;
const allLabelByLang = {
  en: 'All',
  de: 'Alle',
  pl: 'Wszystkie',
  cz: 'Vše',
  sk: 'Všetky',
} as const;
const emptyByLang = {
  en: 'No articles in this category yet.',
  de: 'In dieser Kategorie sind noch keine Artikel.',
  pl: 'W tej kategorii nie ma jeszcze artykułów.',
  cz: 'V této kategorii zatím nejsou články.',
  sk: 'V tejto kategórii zatiaľ nie sú články.',
} as const;
const indexLabelByLang = {
  en: 'Editorial index',
  de: 'Redaktioneller Index',
  pl: 'Indeks redakcyjny',
  cz: 'Redakční index',
  sk: 'Redakčný index',
} as const;
const articlesWordByLang = {
  en: 'articles',
  de: 'Artikel',
  pl: 'artykuły',
  cz: 'články',
  sk: 'články',
} as const;
const allArticlesByLang = {
  en: 'All articles',
  de: 'Alle Artikel',
  pl: 'Wszystkie artykuły',
  cz: 'Všechny články',
  sk: 'Všetky články',
} as const;
const toCategoryKey = (value: string) =>
  value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
const categoryMap = new Map<string, { key: string; label: string; count: number }>();
posts.forEach((post) => {
  const key = toCategoryKey(post.category);
  const current = categoryMap.get(key);
  if (current) {
    current.count += 1;
    return;
  }
  categoryMap.set(key, { key, label: post.category, count: 1 });
});
const categories = Array.from(categoryMap.values()).sort((a, b) => a.label.localeCompare(b.label));
const localeByLang = {
  en: 'en-US',
  de: 'de-DE',
  pl: 'pl-PL',
  cz: 'cs-CZ',
  sk: 'sk-SK',
};
const formatDate = (date: string) =>
  new Intl.DateTimeFormat(localeByLang[lang] ?? 'en-US', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(date));
const blogBase = localizePath('/blog', lang);
const indexLabel = indexLabelByLang[lang];
const articlesWord = articlesWordByLang[lang];
const allArticlesLabel = allArticlesByLang[lang];
---

<BaseLayout
  lang={lang}
  title={copy.pages.blog.meta.title}
  description={copy.pages.blog.meta.description}
>
  <!-- EDITORIAL HERO -->
  <section class="relative overflow-hidden pt-32 pb-14 sm:pt-40 sm:pb-16">
    <div
      class="pointer-events-none absolute left-1/2 top-4 -z-10 h-72 w-[46rem] max-w-full -translate-x-1/2 rounded-full bg-aqua/10 blur-[130px]"
      aria-hidden="true"
    ></div>
    <Container class="relative">
      <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr]">
        <div>
          <span class="inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.03] px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.3em] text-mist">
            <span class="h-1.5 w-1.5 rounded-full bg-aqua shadow-[0_0_12px_2px_rgba(38,202,255,0.8)]"></span>
            {copy.pages.blog.hero.eyebrow}
          </span>
          <h1 class="mt-7 font-display text-5xl font-bold leading-[0.96] tracking-[-0.045em] text-ice sm:text-6xl lg:text-[4.5rem]">
            {copy.pages.blog.hero.title}
          </h1>
          <p class="mt-6 max-w-xl text-lg leading-relaxed text-mist">{copy.pages.blog.hero.subtitle}</p>
          <div class="mt-8 flex flex-wrap items-center gap-2.5">
            <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-coal/50 px-3.5 py-1.5 text-xs font-medium text-ice/80">
              <span class="h-1.5 w-1.5 rounded-full bg-lime"></span>
              {posts.length} {articlesWord}
            </span>
            {categories.slice(0, 4).map((category) => (
              <span class="inline-flex items-center rounded-full border border-aqua/25 bg-aqua/[0.07] px-3 py-1.5 text-xs font-medium text-aqua/90">
                {category.label}
              </span>
            ))}
          </div>
        </div>

        <!-- editorial index panel -->
        <div class="relative">
          <div
            class="pointer-events-none absolute -inset-6 -z-10 rounded-[2.5rem] bg-aqua/[0.05] blur-2xl"
            aria-hidden="true"
          ></div>
          <div class="rounded-[2rem] border border-white/10 bg-coal/60 p-6 backdrop-blur sm:p-7">
            <div class="flex items-center justify-between border-b border-white/10 pb-4">
              <span class="text-[11px] font-semibold uppercase tracking-[0.3em] text-aqua/90">{indexLabel}</span>
              <span class="font-display text-2xl font-bold text-ice">{posts.length}</span>
            </div>
            <div class="mt-4 space-y-1">
              {categories.map((category) => (
                <a
                  href={`${blogBase}?category=${category.key}`}
                  class="group flex items-center justify-between rounded-xl border border-transparent px-3 py-2.5 transition hover:border-aqua/25 hover:bg-aqua/[0.06]"
                >
                  <span class="flex items-center gap-2.5 text-sm text-ice/85 transition group-hover:text-ice">
                    <span class="h-1.5 w-1.5 rounded-full bg-aqua shadow-[0_0_10px_1px_rgba(38,202,255,0.6)]"></span>
                    {category.label}
                  </span>
                  <span class="text-xs font-semibold text-mist transition group-hover:text-aqua">{category.count}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </Container>
  </section>

  <div class="border-t border-white/10"></div>

  <!-- CATEGORY FILTER -->
  <section class="pt-10 pb-2 sm:pt-12">
    <Container>
      <div class="space-y-4" data-blog-filter-root>
        <p class="inline-flex items-center gap-2.5 text-[11px] font-semibold uppercase tracking-[0.3em] text-mist">
          <span class="h-1.5 w-1.5 rounded-full bg-aqua shadow-[0_0_12px_2px_rgba(38,202,255,0.7)]"></span>
          {categoryTitleByLang[lang]}
        </p>
        <div class="flex flex-wrap gap-2">
          <button
            type="button"
            class="tag transition hover:border-aqua/55"
            data-category-button
            data-category-key="all"
          >
            {allLabelByLang[lang]} ({posts.length})
          </button>
          {categories.map((category) => (
            <button
              type="button"
              class="tag transition hover:border-aqua/55"
              data-category-button
              data-category-key={category.key}
            >
              {category.label} ({category.count})
            </button>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <!-- ARTICLE GRID -->
  <section class="py-10 sm:py-12">
    <Container>
      <h2 class="mb-8 font-display text-2xl font-bold tracking-[-0.02em] text-ice sm:text-3xl">{allArticlesLabel}</h2>
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-blog-post-list>
        {posts.map((post) => {
          const href = `${blogBase}/${post.slug}`;
          const image = getBlogImageMeta(post.id);
          return (
            <article
              class="fd-article-card group relative flex flex-col overflow-hidden rounded-3xl border border-white/10 bg-coal/50"
              data-post-category={toCategoryKey(post.category)}
            >
              <a href={href} class="relative block overflow-hidden" tabindex="-1" aria-hidden="true">
                <div class="aspect-[16/9] overflow-hidden bg-night/60">
                  <img
                    src={image.src}
                    alt={post.title}
                    width={image.width}
                    height={image.height}
                    loading="lazy"
                    decoding="async"
                    class="h-full w-full object-cover transition duration-500 group-hover:scale-[1.04]"
                  />
                </div>
              </a>
              <div class="flex flex-1 flex-col p-6">
                <span class="inline-flex w-fit items-center rounded-full border border-aqua/30 bg-aqua/10 px-3 py-1 text-[10px] font-semibold uppercase tracking-[0.2em] text-aqua">
                  {post.category}
                </span>
                <p class="mt-4 text-[11px] uppercase tracking-[0.22em] text-mist">
                  {formatDate(post.date)} · {post.readingTime}
                </p>
                <h3 class="mt-3 font-display text-xl font-bold leading-snug tracking-[-0.02em] text-ice sm:text-[1.4rem]">
                  <a class="transition group-hover:text-aqua" href={href}>{post.title}</a>
                </h3>
                <p class="mt-3 flex-1 text-sm leading-relaxed text-mist">{post.excerpt}</p>
                <a
                  href={href}
                  class="mt-5 inline-flex items-center gap-1.5 text-sm font-semibold text-aqua transition group-hover:gap-2.5"
                >
                  {copy.pages.blog.readMoreLabel}
                  <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14M13 6l6 6-6 6" />
                  </svg>
                </a>
              </div>
            </article>
          );
        })}
      </div>
      <p class="hidden py-12 text-center text-sm text-mist" data-blog-empty>{emptyByLang[lang]}</p>
    </Container>
  </section>

  <script is:inline>
    const initBlogCategoryFilter = () => {
      const root = document.querySelector('[data-blog-filter-root]');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const buttons = Array.from(root.querySelectorAll('[data-category-button]'));
      const posts = Array.from(document.querySelectorAll('[data-post-category]'));
      const emptyState = document.querySelector('[data-blog-empty]');
      if (!buttons.length || !posts.length) return;

      const allowed = new Set(buttons.map((button) => button.getAttribute('data-category-key') || 'all'));
      const basePath = window.location.pathname;
      const parseInitialCategory = () => {
        const fromQuery = new URLSearchParams(window.location.search).get('category') || 'all';
        return allowed.has(fromQuery) ? fromQuery : 'all';
      };

      const setCategory = (key, pushToUrl = true) => {
        buttons.forEach((button) => {
          const active = (button.getAttribute('data-category-key') || 'all') === key;
          button.classList.toggle('border-aqua/60', active);
          button.classList.toggle('bg-aqua', active);
          button.classList.toggle('text-night', active);
          button.classList.toggle('text-aqua', !active);
        });

        let visible = 0;
        posts.forEach((post) => {
          const postCategory = post.getAttribute('data-post-category');
          const show = key === 'all' || postCategory === key;
          post.classList.toggle('hidden', !show);
          if (show) visible += 1;
        });

        if (emptyState) emptyState.classList.toggle('hidden', visible !== 0);

        if (!pushToUrl) return;
        const url = new URL(window.location.href);
        if (key === 'all') {
          url.searchParams.delete('category');
        } else {
          url.searchParams.set('category', key);
        }
        const query = url.searchParams.toString();
        history.replaceState({}, '', query ? `${basePath}?${query}` : basePath);
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          setCategory(button.getAttribute('data-category-key') || 'all');
        });
      });

      window.addEventListener('popstate', () => setCategory(parseInitialCategory(), false));
      setCategory(parseInitialCategory(), false);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBlogCategoryFilter);
    } else {
      initBlogCategoryFilter();
    }

    document.addEventListener('astro:page-load', initBlogCategoryFilter);
  </script>

  <style>
    .fd-article-card {
      transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
    }
    .fd-article-card:hover {
      transform: translateY(-6px);
      border-color: rgba(var(--color-aqua) / 0.4);
      box-shadow: 0 0 0 1px rgba(var(--color-aqua) / 0.18), 0 34px 70px -34px rgba(0, 0, 0, 0.85);
    }
    @media (prefers-reduced-motion: reduce) {
      .fd-article-card {
        transition: none !important;
        transform: none !important;
      }
      .fd-article-card img {
        transition: none !important;
        transform: none !important;
      }
    }
  </style>
</BaseLayout>

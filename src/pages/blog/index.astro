---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import Container from '../../components/Container.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import Cta from '../../components/sections/Cta.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';
import { getBlogPosts } from '../../i18n/blog';
import { localizePath } from '../../i18n/utils';
import { getRoutePath } from '../../i18n/routes';
const lang = defaultLang;
const copy = getCopy(lang);
const posts = getBlogPosts(lang);
---

<BaseLayout
  lang={lang}
  title={copy.pages.blog.meta.title}
  description={copy.pages.blog.meta.description}
>
  <Hero
    lang={lang}
    eyebrow={copy.pages.blog.hero.eyebrow}
    title={copy.pages.blog.hero.title}
    subtitle={copy.pages.blog.hero.subtitle}
    primaryLabel={copy.pages.blog.hero.primaryLabel}
    primaryHref={getRoutePath('contact', lang)}
    secondaryLabel={copy.pages.blog.hero.secondaryLabel}
    secondaryHref={getRoutePath('services', lang)}
  />

  <section class="py-20 sm:py-24">
    <Container class="space-y-10">
      <SectionHeading
        eyebrow={copy.pages.blog.listHeading.eyebrow}
        title={copy.pages.blog.listHeading.title}
        subtitle={copy.pages.blog.listHeading.subtitle}
      />
      <div class="grid gap-6 md:grid-cols-3">
        {posts.map((post) => (
          <article class="card card-3d flex h-full flex-col">
            <div class="flex items-center gap-2 text-[11px] uppercase tracking-[0.25em] text-aqua/85">
              <span class="badge">{post.category}</span>
              <span class="text-mist/80">{post.readingTime}</span>
            </div>
            <h3 class="mt-4 font-display text-xl">{post.title}</h3>
            <p class="mt-3 text-sm text-mist">{post.excerpt}</p>
            <div class="mt-auto pt-6">
              <a
                class="text-sm font-semibold text-aqua transition hover:text-ice"
                href={`${localizePath('/blog', lang)}/${post.slug}`}
              >
                {copy.pages.blog.readMoreLabel} →
              </a>
            </div>
          </article>
        ))}
      </div>
    </Container>
  </section>

  <Cta lang={lang} />
</BaseLayout>

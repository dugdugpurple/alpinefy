---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import Cta from '../../components/sections/Cta.astro';
import { site } from '../../data/site';
import { defaultLang } from '../../i18n/languages';
import { getBlogPost, getBlogPosts } from '../../i18n/blog';
import { getCopy } from '../../i18n/copy';
import { localizePath } from '../../i18n/utils';

export function getStaticPaths() {
  return getBlogPosts(defaultLang).map((post) => ({ params: { slug: post.slug } }));
}

const lang = defaultLang;
const copy = getCopy(lang);
const { slug } = Astro.params;
const post = getBlogPost(lang, slug);

if (!post) {
  throw new Error('Post not found');
}

const articleUrl = `${site.url}${localizePath(`/blog/${post.slug}`, lang)}`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  inLanguage: lang,
  mainEntityOfPage: articleUrl,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
};
---

<BaseLayout
  lang={lang}
  title={post.title}
  description={post.excerpt}
  type="article"
  publishedTime={post.date}
  modifiedTime={post.date}
  keywords={[post.category, 'SEO', 'web performance', 'shopify', 'web agency']}
  structuredData={articleSchema}
>
  <section class="py-20 sm:py-24">
    <Container class="space-y-10">
      <a class="mb-2 inline-flex items-center gap-2 text-xs uppercase tracking-[0.28em] text-aqua/85 transition hover:text-ice" href={localizePath('/blog', lang)}>
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"></path>
        </svg>
        {copy.pages.blog.backLabel}
      </a>
      <div class="space-y-4 rounded-3xl border border-white/12 bg-coal/55 p-6 sm:p-8">
        <div class="flex flex-wrap items-center gap-2 text-xs uppercase tracking-[0.24em] text-mist">
          <span class="badge">{post.category}</span>
          <span>{post.readingTime}</span>
          <span>{post.date}</span>
        </div>
        <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl">{post.title}</h1>
        <p class="max-w-2xl text-base text-mist">{post.excerpt}</p>
      </div>

      <div class="space-y-6">
        {post.sections.map((section) => (
          <section class="card space-y-4 rounded-3xl">
            <h2 class="font-display text-2xl">{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => (
              <p class="text-sm text-mist sm:text-base">{paragraph}</p>
            ))}
            {section.list && (
              <ul class="list-disc space-y-2 pl-5 text-sm text-mist sm:text-base">
                {section.list.map((item) => (
                  <li>{item}</li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </div>
    </Container>
  </section>

  <Cta lang={lang} />
</BaseLayout>

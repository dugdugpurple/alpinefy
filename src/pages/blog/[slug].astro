---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { site } from '../../data/site';
import { defaultLang } from '../../i18n/languages';
import { getBlogPost, getBlogPosts } from '../../i18n/blog';
import { getCopy } from '../../i18n/copy';
import { localizePath } from '../../i18n/utils';

export function getStaticPaths() {
  return getBlogPosts(defaultLang).map((post) => ({ params: { slug: post.slug } }));
}

const lang = defaultLang;
const copy = getCopy(lang);
const { slug } = Astro.params;
const post = getBlogPost(lang, slug);

if (!post) {
  throw new Error('Post not found');
}

const articleUrl = `${site.url}${localizePath(`/blog/${post.slug}`, lang)}`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  inLanguage: lang,
  mainEntityOfPage: articleUrl,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
};
const localeByLang = {
  en: 'en-US',
  de: 'de-DE',
  pl: 'pl-PL',
  cz: 'cs-CZ',
  sk: 'sk-SK',
};
const publishedLabelByLang = {
  en: 'Published',
  de: 'Veröffentlicht',
  pl: 'Opublikowano',
  cz: 'Publikováno',
  sk: 'Publikované',
};
const formattedDate = new Intl.DateTimeFormat(localeByLang[lang] ?? 'en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(post.date));
const publishedLabel = publishedLabelByLang[lang] ?? publishedLabelByLang.en;
const relatedPosts = getBlogPosts(lang)
  .filter((item) => item.id !== post.id)
  .sort((a, b) => {
    const categoryScore = Number(b.category === post.category) - Number(a.category === post.category);
    if (categoryScore !== 0) return categoryScore;
    return new Date(b.date).getTime() - new Date(a.date).getTime();
  })
  .slice(0, 3);
const servicesHref = localizePath('/services', lang);
const contactHref = localizePath('/contact', lang);
const relatedHeading = 'Related SEO insights';
const relatedIntro = 'Continue with practical topics that connect performance, technical SEO and growth.';
const implementationTitle = 'Want this implemented on your website?';
const implementationText =
  'We can turn these recommendations into concrete changes on your pages, templates and analytics setup.';
const servicesLabel = 'View services';
const contactLabel = 'Book a consultation';
const readArticleLabel = 'Read article';
---

<BaseLayout
  lang={lang}
  title={post.title}
  description={post.excerpt}
  type="article"
  publishedTime={post.date}
  modifiedTime={post.date}
  keywords={[post.category, 'SEO', 'web performance', 'shopify', 'web agency']}
  structuredData={articleSchema}
>
  <section class="pt-28 pb-14 sm:pt-32 sm:pb-16">
    <Container class="max-w-[1120px]">
      <a
        class="inline-flex items-center gap-2 text-xs uppercase tracking-[0.28em] text-aqua/85 transition hover:text-ice"
        href={localizePath('/blog', lang)}
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"></path>
        </svg>
        {copy.pages.blog.backLabel}
      </a>
      <div class="mt-10 max-w-4xl space-y-6 sm:space-y-7">
        <div class="text-[11px] uppercase tracking-[0.24em] text-aqua/82">
          {post.category}
        </div>
        <h1 class="font-display text-4xl leading-[1.03] sm:text-5xl lg:text-6xl">{post.title}</h1>
        <p class="max-w-2xl text-base text-mist sm:text-lg">{post.excerpt}</p>
        <p class="text-sm text-mist/80">
          {publishedLabel}: {formattedDate} · {post.readingTime}
        </p>
      </div>
    </Container>
  </section>

  <div class="border-t border-white/10"></div>

  <section class="py-14 sm:py-16">
    <Container class="max-w-[1120px]">
      <article class="max-w-3xl space-y-12 sm:space-y-14">
        {post.sections.map((section) => (
          <section class="space-y-5">
            <h2 class="font-display text-3xl sm:text-4xl">{section.heading}</h2>
            {section.paragraphs?.map((paragraph) => (
              <p class="text-base leading-relaxed text-mist">{paragraph}</p>
            ))}
            {section.list && (
              <ul class="space-y-3">
                {section.list.map((item) => (
                  <li class="flex items-start gap-3 text-base leading-relaxed text-mist">
                    <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-aqua/90"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}
      </article>
    </Container>
  </section>

  <div class="border-t border-white/10"></div>

  <section class="py-12 sm:py-14">
    <Container class="max-w-[1120px]">
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <div class="space-y-4">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-aqua/85">{relatedHeading}</p>
          <p class="max-w-2xl text-sm text-mist sm:text-base">{relatedIntro}</p>
          <div class="divide-y divide-white/10 rounded-2xl border border-white/10 bg-white/4">
            {relatedPosts.map((related) => (
              <article class="p-4 sm:p-5">
                <p class="text-[11px] uppercase tracking-[0.2em] text-aqua/80">
                  {related.category} · {related.readingTime}
                </p>
                <h3 class="mt-2 font-display text-xl">
                  <a class="transition hover:text-aqua" href={`${localizePath('/blog', lang)}/${related.slug}`}>
                    {related.title}
                  </a>
                </h3>
                <p class="mt-2 text-sm text-mist">{related.excerpt}</p>
                <a
                  class="mt-3 inline-flex text-sm font-semibold text-aqua transition hover:text-ice"
                  href={`${localizePath('/blog', lang)}/${related.slug}`}
                >
                  {readArticleLabel} →
                </a>
              </article>
            ))}
          </div>
        </div>

        <aside class="card h-fit space-y-4 rounded-2xl">
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-aqua/85">Internal linking</p>
          <h3 class="font-display text-2xl">{implementationTitle}</h3>
          <p class="text-sm text-mist sm:text-base">{implementationText}</p>
          <div class="flex flex-wrap gap-3">
            <a class="btn-primary" href={contactHref}>{contactLabel}</a>
            <a class="btn-secondary" href={servicesHref}>{servicesLabel}</a>
          </div>
        </aside>
      </div>
    </Container>
  </section>
</BaseLayout>

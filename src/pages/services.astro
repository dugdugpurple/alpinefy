---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/sections/Hero.astro';
import TrustBadges from '../components/sections/TrustBadges.astro';
import Services from '../components/sections/Services.astro';
import ValueProps from '../components/sections/ValueProps.astro';
import Capabilities from '../components/sections/Capabilities.astro';
import Cta from '../components/sections/Cta.astro';
import { defaultLang } from '../i18n/languages';
import { getCopy } from '../i18n/copy';
import { getRoutePath } from '../i18n/routes';
const lang = defaultLang;
const copy = getCopy(lang);
---

<BaseLayout
  lang={lang}
  title={copy.pages.services.meta.title}
  description={copy.pages.services.meta.description}
>
  <Hero
    lang={lang}
    eyebrow={copy.pages.services.hero.eyebrow}
    title={copy.pages.services.hero.title}
    subtitle={copy.pages.services.hero.subtitle}
    primaryLabel={copy.pages.services.hero.primaryLabel}
    primaryHref={getRoutePath('contact', lang)}
    secondaryLabel={copy.pages.services.hero.secondaryLabel}
    secondaryHref={getRoutePath('process', lang)}
  />
  <TrustBadges lang={lang} />
  <Services lang={lang} mode="services" />
  <Capabilities lang={lang} />
  <ValueProps lang={lang} />
  <Cta lang={lang} />
</BaseLayout>

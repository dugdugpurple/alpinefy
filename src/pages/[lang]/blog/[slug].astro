---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import BlogCategoryPill from '../../../components/blog/BlogCategoryPill.astro';
import { site } from '../../../data/site';
import { languages, defaultLang, isSupportedLang } from '../../../i18n/languages';
import { getBlogPost, getBlogPosts } from '../../../i18n/blog';
import { getBlogImageMeta } from '../../../i18n/blogImages';
import { getBlogCtaTarget, getBlogServicesLabel } from '../../../i18n/blogCta';
import { getCopy } from '../../../i18n/copy';
import { localizePath } from '../../../i18n/utils';

export function getStaticPaths() {
  return languages
    .filter((item) => item.code !== defaultLang)
    .flatMap((item) =>
      getBlogPosts(item.code).map((post) => ({ params: { lang: item.code, slug: post.slug } }))
    );
}

const { lang, slug } = Astro.params;
if (!lang || !isSupportedLang(lang) || lang === defaultLang) {
  throw new Error('Unsupported language');
}
const copy = getCopy(lang);
const post = getBlogPost(lang, slug);

if (!post) {
  throw new Error('Post not found');
}

const articleUrl = `${site.url}${localizePath(`/blog/${post.slug}`, lang)}`;
const blogImage = getBlogImageMeta(post.id);
const blogImageUrl = blogImage.src.startsWith('http') ? blogImage.src : `${site.url}${blogImage.src}`;
const imageTopicLabelByLang = {
  en: 'Topic',
  de: 'Thema',
  pl: 'Temat',
  cz: 'Téma',
  sk: 'Téma',
};
const imageAltPrefixByLang = {
  en: 'Illustration for',
  de: 'Illustration zu',
  pl: 'Ilustracja do artykułu',
  cz: 'Ilustrace k článku',
  sk: 'Ilustrácia k článku',
};
const imageTopicLabel = imageTopicLabelByLang[lang] ?? imageTopicLabelByLang.en;
const imageAltPrefix = imageAltPrefixByLang[lang] ?? imageAltPrefixByLang.en;
const blogImageAlt = `${imageAltPrefix}: ${post.title}. ${imageTopicLabel}: ${post.category}.`;
const blogImageCaption = `${imageTopicLabel}: ${post.category}`;
const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.title,
  description: post.excerpt,
  datePublished: post.date,
  dateModified: post.date,
  inLanguage: lang,
  mainEntityOfPage: articleUrl,
  image: {
    '@type': 'ImageObject',
    url: blogImageUrl,
    width: blogImage.width,
    height: blogImage.height,
    caption: blogImageAlt,
  },
  thumbnailUrl: blogImageUrl,
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
};
const localeByLang = {
  en: 'en-US',
  de: 'de-DE',
  pl: 'pl-PL',
  cz: 'cs-CZ',
  sk: 'sk-SK',
};
const publishedLabelByLang = {
  en: 'Published',
  de: 'Veröffentlicht',
  pl: 'Opublikowano',
  cz: 'Publikováno',
  sk: 'Publikované',
};
const formattedDate = new Intl.DateTimeFormat(localeByLang[lang] ?? 'en-US', {
  day: 'numeric',
  month: 'long',
  year: 'numeric',
}).format(new Date(post.date));
const publishedLabel = publishedLabelByLang[lang] ?? publishedLabelByLang.en;
const relatedHeadingByLang = {
  en: 'Related SEO insights',
  de: 'Ähnliche SEO-Themen',
  pl: 'Powiązane artykuły SEO',
  cz: 'Související SEO články',
  sk: 'Súvisiace SEO články',
};
const relatedIntroByLang = {
  en: 'Continue with practical topics that connect performance, technical SEO and growth.',
  de: 'Vertiefen Sie das Thema mit praktischen Beiträgen, die Performance, technisches SEO und Wachstum verbinden.',
  pl: 'Przejdź na kolejne praktyczne tematy łączące wydajność, SEO techniczne i wzrost.',
  cz: 'Pokračujte praktickými tématy, která propojují výkon, technické SEO a růst.',
  sk: 'Pokračujte praktickými témami, ktoré prepájajú výkon, technické SEO a rast.',
};
const implementationTitleByLang = {
  en: 'Want this implemented on your website?',
  de: 'Möchten Sie das auf Ihrer Website umsetzen?',
  pl: 'Chcesz wdrożyć to na swojej stronie?',
  cz: 'Chcete to nasadit na svém webu?',
  sk: 'Chcete to nasadiť na svoj web?',
};
const implementationTextByLang = {
  en: 'We can turn these recommendations into concrete changes on your pages, templates and analytics setup.',
  de: 'Diese Empfehlungen setzen wir in konkrete Änderungen an Seiten, Templates und Analytics um.',
  pl: 'Możemy zamienić te rekomendacje na konkretne zmiany w stronach, szablonach i analityce.',
  cz: 'Doporučení umíme převést do konkrétních úprav stránek, šablon a analytiky.',
  sk: 'Tieto odporúčania vieme premeniť na konkrétne úpravy stránok, šablón a analytiky.',
};
const servicesLabelByLang = {
  en: 'View services',
  de: 'Leistungen',
  pl: 'Usługi',
  cz: 'Služby',
  sk: 'Služby',
};
const contactLabelByLang = {
  en: 'Book a consultation',
  de: 'Beratung buchen',
  pl: 'Umów konsultację',
  cz: 'Rezervovat konzultaci',
  sk: 'Rezervovať konzultáciu',
};
const readArticleLabelByLang = {
  en: 'Read article',
  de: 'Artikel lesen',
  pl: 'Czytaj artykuł',
  cz: 'Číst článek',
  sk: 'Čítať článok',
};
const internalLinkingLabelByLang = {
  en: 'Recommended next step',
  de: 'Empfohlener nächster Schritt',
  pl: 'Rekomendowany kolejny krok',
  cz: 'Doporučený další krok',
  sk: 'Odporúčaný ďalší krok',
};
const focusPrefixByLang = {
  en: 'Recommended focus',
  de: 'Empfohlener Fokus',
  pl: 'Rekomendowany fokus',
  cz: 'Doporučený fokus',
  sk: 'Odporúčaný fokus',
};
const relatedPosts = getBlogPosts(lang)
  .filter((item) => item.id !== post.id)
  .sort((a, b) => {
    const categoryScore = Number(b.category === post.category) - Number(a.category === post.category);
    if (categoryScore !== 0) return categoryScore;
    return new Date(b.date).getTime() - new Date(a.date).getTime();
  })
  .slice(0, 3);
const ctaTarget = getBlogCtaTarget(post);
const servicesHref = `${localizePath('/services', lang)}${ctaTarget.anchor}`;
const contactHref = localizePath('/contact', lang);
const relatedHeading = relatedHeadingByLang[lang] ?? relatedHeadingByLang.en;
const relatedIntro = relatedIntroByLang[lang] ?? relatedIntroByLang.en;
const implementationTitle = implementationTitleByLang[lang] ?? implementationTitleByLang.en;
const implementationText = implementationTextByLang[lang] ?? implementationTextByLang.en;
const defaultServicesLabel = servicesLabelByLang[lang] ?? servicesLabelByLang.en;
const servicesLabel = getBlogServicesLabel(lang, ctaTarget.topic) || defaultServicesLabel;
const contactLabel = contactLabelByLang[lang] ?? contactLabelByLang.en;
const readArticleLabel = readArticleLabelByLang[lang] ?? readArticleLabelByLang.en;
const internalLinkingLabel = internalLinkingLabelByLang[lang] ?? internalLinkingLabelByLang.en;
const focusPrefix = focusPrefixByLang[lang] ?? focusPrefixByLang.en;
const focusLine = `${focusPrefix}: ${servicesLabel}`;
---

<BaseLayout
  lang={lang}
  title={post.title}
  description={post.excerpt}
  image={blogImage.src}
  imageAlt={blogImageAlt}
  imageWidth={blogImage.width}
  imageHeight={blogImage.height}
  imageType={blogImage.type}
  type="article"
  publishedTime={post.date}
  modifiedTime={post.date}
  keywords={[post.category, 'SEO', 'web performance', 'shopify', 'web agency']}
  structuredData={articleSchema}
>
  <section class="pt-28 pb-14 sm:pt-32 sm:pb-16">
    <Container class="max-w-[1120px]">
      <a
        class="inline-flex items-center gap-2 text-xs font-semibold uppercase tracking-[0.28em] text-mist transition duration-300 hover:text-aqua"
        href={localizePath('/blog', lang)}
      >
        <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"></path>
        </svg>
        {copy.pages.blog.backLabel}
      </a>
      <div class="mt-10 max-w-4xl space-y-6 sm:space-y-7">
        <BlogCategoryPill category={post.category} topic={ctaTarget.topic} />
        <h1 class="font-display text-4xl font-bold leading-[1.03] tracking-[-0.035em] sm:text-5xl lg:text-6xl">
          {post.title}
        </h1>
        <p class="max-w-2xl text-base text-mist sm:text-lg">{post.excerpt}</p>
        <div class="flex items-center gap-2.5 text-sm text-mist/80">
          <span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>
          <span>{publishedLabel}: {formattedDate}</span>
          <span class="text-mist/40">·</span>
          <span>{post.readingTime}</span>
        </div>
        <figure class="overflow-hidden rounded-3xl border border-white/10 bg-coal/70">
          <img
            src={blogImage.src}
            alt={blogImageAlt}
            width={blogImage.width}
            height={blogImage.height}
            class="h-auto w-full object-cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
          <figcaption class="border-t border-white/10 px-4 py-3 text-xs text-mist/75 sm:px-5">
            {blogImageCaption}
          </figcaption>
        </figure>
      </div>
    </Container>
  </section>

  <div class="border-t border-white/10"></div>

  <section class="py-14 sm:py-16">
    <Container class="max-w-[1120px]">
      <article class="article-prose max-w-3xl space-y-12 sm:space-y-14">
        {post.sections.map((section) => (
          <section class="space-y-5">
            <h2 class="flex items-start gap-3 font-display text-2xl font-bold leading-tight tracking-[-0.02em] text-ice sm:text-[1.9rem]">
              <span class="mt-2 h-6 w-1 shrink-0 rounded-full bg-gradient-to-b from-aqua to-lime sm:mt-2.5"></span>
              <span>{section.heading}</span>
            </h2>
            {section.paragraphs?.map((paragraph) => (
              <p class="text-[15px] leading-[1.8] text-mist sm:text-base">{paragraph}</p>
            ))}
            {section.list && (
              <ul class="space-y-3 pt-1">
                {section.list.map((item) => (
                  <li class="flex items-start gap-3 text-[15px] leading-[1.8] text-mist sm:text-base">
                    <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-gradient-to-br from-aqua to-lime"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}

        <div class="border-t border-white/10 pt-8">
          <a
            class="inline-flex items-center gap-2 text-sm font-semibold text-aqua transition duration-300 hover:gap-3 hover:text-ice"
            href={localizePath('/blog', lang)}
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M15 6l-6 6 6 6"></path>
            </svg>
            {copy.pages.blog.backLabel}
          </a>
        </div>
      </article>
    </Container>
  </section>

  <div class="border-t border-white/10"></div>

  <section class="py-12 sm:py-16">
    <Container class="max-w-[1120px]">
      <div class="grid gap-8 lg:grid-cols-[1.15fr_0.85fr]">
        <div class="space-y-5">
          <div class="flex items-center gap-2.5">
            <span class="h-1.5 w-1.5 rounded-full bg-lime"></span>
            <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-mist">{relatedHeading}</p>
          </div>
          <p class="max-w-2xl text-sm text-mist sm:text-base">{relatedIntro}</p>
          <div class="grid gap-4">
            {relatedPosts.map((related) => (
              <article class="card group">
                <p class="text-[11px] uppercase tracking-[0.22em] text-mist/80">
                  {related.category} · {related.readingTime}
                </p>
                <h3 class="mt-2 font-display text-lg font-bold leading-snug tracking-[-0.02em] text-ice sm:text-xl">
                  <a class="transition duration-300 group-hover:text-aqua" href={`${localizePath('/blog', lang)}/${related.slug}`}>
                    {related.title}
                  </a>
                </h3>
                <p class="mt-2 text-sm leading-relaxed text-mist">{related.excerpt}</p>
                <a
                  class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-aqua transition duration-300 hover:gap-2.5 hover:text-ice"
                  href={`${localizePath('/blog', lang)}/${related.slug}`}
                >
                  {readArticleLabel}
                  <span aria-hidden="true">→</span>
                </a>
              </article>
            ))}
          </div>
        </div>

        <aside class="card h-fit space-y-4">
          <div class="flex items-center gap-2.5">
            <span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>
            <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-mist">{internalLinkingLabel}</p>
          </div>
          <h3 class="font-display text-2xl font-bold leading-tight tracking-[-0.02em] text-ice">{implementationTitle}</h3>
          <p class="text-sm leading-relaxed text-mist sm:text-base">{implementationText}</p>
          <p class="text-sm font-semibold text-aqua">{focusLine}</p>
          <div class="flex flex-wrap gap-3 pt-1">
            <a class="btn-primary" href={contactHref}>{contactLabel}</a>
            <a class="btn-secondary" href={servicesHref}>{servicesLabel}</a>
          </div>
        </aside>
      </div>
    </Container>
  </section>
</BaseLayout>

<style>
  /* FD prose treatment for any rich content rendered inside an article. */
  .article-prose a {
    color: rgb(var(--color-aqua));
    text-decoration: underline;
    text-decoration-color: rgba(var(--color-aqua) / 0.4);
    text-underline-offset: 3px;
    transition: color 0.3s ease, text-decoration-color 0.3s ease;
  }

  .article-prose a:hover {
    color: rgb(var(--color-ice));
    text-decoration-color: rgba(var(--color-ice) / 0.6);
  }

  .article-prose strong {
    color: rgb(var(--color-ice));
    font-weight: 600;
  }

  .article-prose code {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 0.9em;
    color: rgb(var(--color-lime));
    background: rgba(var(--color-ice) / 0.06);
    border: 1px solid rgba(var(--color-ice) / 0.08);
    border-radius: 0.4rem;
    padding: 0.12em 0.4em;
  }

  .article-prose blockquote {
    border-left: 2px solid rgba(var(--color-aqua) / 0.6);
    padding-left: 1.25rem;
    color: rgba(var(--color-ice) / 0.9);
    font-style: italic;
  }
</style>

---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Container from '../../../components/Container.astro';
import BlogCategoryPill from '../../../components/blog/BlogCategoryPill.astro';
import { languages, defaultLang, isSupportedLang } from '../../../i18n/languages';
import { getCopy } from '../../../i18n/copy';
import { getBlogPosts } from '../../../i18n/blog';
import { getBlogImageMeta } from '../../../i18n/blogImages';
import { getBlogCtaTarget } from '../../../i18n/blogCta';
import { localizePath } from '../../../i18n/utils';

export function getStaticPaths() {
  return languages
    .filter((item) => item.code !== defaultLang)
    .map((item) => ({ params: { lang: item.code } }));
}

const { lang } = Astro.params;
if (!lang || !isSupportedLang(lang) || lang === defaultLang) {
  throw new Error('Unsupported language');
}
const copy = getCopy(lang);
const posts = getBlogPosts(lang);
const categoryTitleByLang = {
  en: 'Categories',
  de: 'Kategorien',
  pl: 'Kategorie',
  cz: 'Kategorie',
  sk: 'Kategórie',
} as const;
const allLabelByLang = {
  en: 'All',
  de: 'Alle',
  pl: 'Wszystkie',
  cz: 'Vše',
  sk: 'Všetky',
} as const;
const emptyByLang = {
  en: 'No articles in this category yet.',
  de: 'In dieser Kategorie sind noch keine Artikel.',
  pl: 'W tej kategorii nie ma jeszcze artykułów.',
  cz: 'V této kategorii zatím nejsou články.',
  sk: 'V tejto kategórii zatiaľ nie sú články.',
} as const;
const toCategoryKey = (value: string) =>
  value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .toLowerCase()
    .trim()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
const categoryMap = new Map<string, { key: string; label: string; count: number }>();
posts.forEach((post) => {
  const key = toCategoryKey(post.category);
  const current = categoryMap.get(key);
  if (current) {
    current.count += 1;
    return;
  }
  categoryMap.set(key, { key, label: post.category, count: 1 });
});
const categories = Array.from(categoryMap.values()).sort((a, b) => a.label.localeCompare(b.label));
const localeByLang = {
  en: 'en-US',
  de: 'de-DE',
  pl: 'pl-PL',
  cz: 'cs-CZ',
  sk: 'sk-SK',
};
const formatDate = (date: string) =>
  new Intl.DateTimeFormat(localeByLang[lang] ?? 'en-US', {
    day: 'numeric',
    month: 'long',
    year: 'numeric',
  }).format(new Date(date));
---

<BaseLayout lang={lang} title={copy.pages.blog.meta.title} description={copy.pages.blog.meta.description}>
  <section class="pt-28 pb-12 sm:pt-32 sm:pb-16">
    <Container class="max-w-[1120px] space-y-6">
      <div class="flex items-center gap-2.5">
        <span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>
        <p class="text-[11px] font-semibold uppercase tracking-[0.32em] text-mist">
          {copy.pages.blog.hero.eyebrow}
        </p>
      </div>
      <h1 class="max-w-4xl font-display text-4xl font-bold leading-[1.03] tracking-[-0.035em] sm:text-5xl lg:text-6xl">
        {copy.pages.blog.hero.title}
      </h1>
      <p class="max-w-2xl text-base text-mist sm:text-lg">{copy.pages.blog.hero.subtitle}</p>
    </Container>
  </section>

  <div class="border-t border-white/10"></div>

  <section class="pt-8 pb-2 sm:pt-10">
    <Container class="max-w-[1120px]">
      <div class="space-y-4" data-blog-filter-root>
        <div class="flex items-center gap-2.5">
          <span class="h-1.5 w-1.5 rounded-full bg-lime"></span>
          <p class="text-[11px] font-semibold uppercase tracking-[0.28em] text-mist">{categoryTitleByLang[lang]}</p>
        </div>
        <div class="flex flex-wrap gap-2.5">
          <button
            type="button"
            class="tag transition duration-300 hover:border-aqua/55 hover:text-ice"
            data-category-button
            data-category-key="all"
          >
            {allLabelByLang[lang]} ({posts.length})
          </button>
          {categories.map((category) => (
            <button
              type="button"
              class="tag transition duration-300 hover:border-aqua/55 hover:text-ice"
              data-category-button
              data-category-key={category.key}
            >
              {category.label} ({category.count})
            </button>
          ))}
        </div>
      </div>
    </Container>
  </section>

  <section class="pt-8 pb-24 sm:pt-10">
    <Container class="max-w-[1120px]">
      <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3" data-blog-post-list>
        {posts.map((post) => {
          const image = getBlogImageMeta(post.id);
          const topic = getBlogCtaTarget(post).topic;
          const href = `${localizePath('/blog', lang)}/${post.slug}`;
          return (
            <article
              class="card group flex h-full flex-col"
              data-post-category={toCategoryKey(post.category)}
            >
              <a href={href} class="block overflow-hidden rounded-2xl border border-white/10 bg-coal/60">
                <img
                  src={image.src}
                  alt={`Illustration for ${post.title}. Topic: ${post.category}.`}
                  width={image.width}
                  height={image.height}
                  class="aspect-[16/10] w-full object-cover transition duration-500 group-hover:scale-[1.04]"
                  loading="lazy"
                  decoding="async"
                />
              </a>
              <div class="mt-6 flex flex-1 flex-col gap-4">
                <div class="flex flex-wrap items-center gap-3">
                  <BlogCategoryPill category={post.category} topic={topic} />
                </div>
                <p class="text-[11px] uppercase tracking-[0.22em] text-mist/80">
                  {formatDate(post.date)} · {post.readingTime}
                </p>
                <h2 class="font-display text-xl font-bold leading-snug tracking-[-0.02em] text-ice sm:text-[1.4rem]">
                  <a class="transition duration-300 group-hover:text-aqua" href={href}>
                    {post.title}
                  </a>
                </h2>
                <p class="text-sm leading-relaxed text-mist">{post.excerpt}</p>
                <a
                  class="mt-auto inline-flex items-center gap-1.5 pt-1 text-sm font-semibold text-aqua transition duration-300 hover:gap-2.5 hover:text-ice"
                  href={href}
                >
                  {copy.pages.blog.readMoreLabel}
                  <span aria-hidden="true">→</span>
                </a>
              </div>
            </article>
          );
        })}
      </div>
      <p class="hidden py-16 text-center text-sm text-mist" data-blog-empty>{emptyByLang[lang]}</p>
    </Container>
  </section>

  <script is:inline>
    const initBlogCategoryFilter = () => {
      const root = document.querySelector('[data-blog-filter-root]');
      if (!root || root.dataset.ready === 'true') return;
      root.dataset.ready = 'true';

      const buttons = Array.from(root.querySelectorAll('[data-category-button]'));
      const posts = Array.from(document.querySelectorAll('[data-post-category]'));
      const emptyState = document.querySelector('[data-blog-empty]');
      if (!buttons.length || !posts.length) return;

      const allowed = new Set(buttons.map((button) => button.getAttribute('data-category-key') || 'all'));
      const basePath = window.location.pathname;
      const parseInitialCategory = () => {
        const fromQuery = new URLSearchParams(window.location.search).get('category') || 'all';
        return allowed.has(fromQuery) ? fromQuery : 'all';
      };

      const setCategory = (key, pushToUrl = true) => {
        buttons.forEach((button) => {
          const active = (button.getAttribute('data-category-key') || 'all') === key;
          button.classList.toggle('border-aqua/60', active);
          button.classList.toggle('bg-aqua', active);
          button.classList.toggle('text-night', active);
          button.classList.toggle('text-aqua', !active);
        });

        let visible = 0;
        posts.forEach((post) => {
          const postCategory = post.getAttribute('data-post-category');
          const show = key === 'all' || postCategory === key;
          post.classList.toggle('hidden', !show);
          if (show) visible += 1;
        });

        if (emptyState) emptyState.classList.toggle('hidden', visible !== 0);

        if (!pushToUrl) return;
        const url = new URL(window.location.href);
        if (key === 'all') {
          url.searchParams.delete('category');
        } else {
          url.searchParams.set('category', key);
        }
        const query = url.searchParams.toString();
        history.replaceState({}, '', query ? `${basePath}?${query}` : basePath);
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          setCategory(button.getAttribute('data-category-key') || 'all');
        });
      });

      window.addEventListener('popstate', () => setCategory(parseInitialCategory(), false));
      setCategory(parseInitialCategory(), false);
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBlogCategoryFilter);
    } else {
      initBlogCategoryFilter();
    }

    document.addEventListener('astro:page-load', initBlogCategoryFilter);
  </script>
</BaseLayout>

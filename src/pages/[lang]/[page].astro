---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import FdServicesHero from '../../components/sections/FdServicesHero.astro';
import FdServicesDetailed from '../../components/sections/FdServicesDetailed.astro';
import FdProcessHero from '../../components/sections/FdProcessHero.astro';
import FdProcess from '../../components/sections/FdProcess.astro';
import FdReferencesHero from '../../components/sections/FdReferencesHero.astro';
import FdAboutHero from '../../components/sections/FdAboutHero.astro';
import FdAbout from '../../components/sections/FdAbout.astro';
import FdCapabilities from '../../components/sections/FdCapabilities.astro';
import FdFaq from '../../components/sections/FdFaq.astro';
import FdCta from '../../components/sections/FdCta.astro';
import PricingCalculator from '../../components/sections/PricingCalculator.astro';
import ReferencesShowcase from '../../components/sections/ReferencesShowcase.astro';
import LegalContent from '../../components/pages/LegalContent.astro';
import ContactView from '../../components/pages/ContactView.astro';
import Container from '../../components/Container.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { attributionFieldNames, getContactIntakeCopy } from '../../data/contact-intake';
import { getDisplayPhone, getPhoneDialValue, site } from '../../data/site';
import { languages, defaultLang, isSupportedLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';
import { getLegalCopy } from '../../i18n/legal';
import { getRoutePath, getRouteKeyFromPath, pageKeys } from '../../i18n/routes';

export function getStaticPaths() {
  return languages
    .filter((item) => item.code !== defaultLang)
    .flatMap((item) =>
      pageKeys.map((key) => {
        const fullPath = getRoutePath(key, item.code);
        const segments = fullPath.split('/').filter(Boolean);
        const slug = segments.slice(1).join('/');
        return {
          params: { lang: item.code, page: slug },
          props: { routeKey: key },
        };
      })
    );
}

const { lang, page } = Astro.params;
if (!lang || !isSupportedLang(lang) || lang === defaultLang) {
  throw new Error('Unsupported language');
}

const routeKey = Astro.props.routeKey ?? getRouteKeyFromPath(`/${lang}/${page}`);
if (!routeKey || routeKey === 'home' || routeKey === 'blog' || routeKey === 'thankYou') {
  throw new Error('Unknown page');
}

const copy = getCopy(lang);
const legal = getLegalCopy(lang);
const meta =
  routeKey === 'services'
    ? copy.pages.services.meta
    : routeKey === 'process'
      ? copy.pages.process.meta
      : routeKey === 'references'
        ? copy.pages.references.meta
        : routeKey === 'about'
          ? copy.pages.about.meta
          : routeKey === 'contact'
            ? copy.pages.contact.meta
            : routeKey === 'privacy'
              ? legal.privacy.meta
              : routeKey === 'cookies'
                ? legal.cookies.meta
                : null;

if (!meta) {
  throw new Error('Unknown page');
}
const contactFormName = 'contact-inquiry';
const currentPath = Astro.url.pathname;
const phoneLabel = getDisplayPhone(lang);
const phoneDial = getPhoneDialValue();
const intake = getContactIntakeCopy(lang);
---

<BaseLayout lang={lang} title={meta.title} description={meta.description}>
  {routeKey === 'services' && (
    <>
      <FdServicesHero
        lang={lang}
        eyebrow={copy.pages.services.hero.eyebrow}
        title={copy.pages.services.hero.title}
        subtitle={copy.pages.services.hero.subtitle}
        primaryLabel={copy.pages.services.hero.primaryLabel}
        primaryHref={getRoutePath('contact', lang)}
        secondaryLabel={copy.pages.services.hero.secondaryLabel}
        secondaryHref={getRoutePath('process', lang)}
      />
      <FdServicesDetailed lang={lang} />
      <PricingCalculator lang={lang} />
      <FdCapabilities lang={lang} />
      <FdCta lang={lang} />
    </>
  )}

  {routeKey === 'process' && (
    <>
      <FdProcessHero
        lang={lang}
        eyebrow={copy.pages.process.hero.eyebrow}
        title={copy.pages.process.hero.title}
        subtitle={copy.pages.process.hero.subtitle}
        primaryLabel={copy.pages.process.hero.primaryLabel}
        primaryHref={getRoutePath('contact', lang)}
        secondaryLabel={copy.pages.process.hero.secondaryLabel}
        secondaryHref={getRoutePath('services', lang)}
      />
      <FdProcess lang={lang} />
      <FdFaq lang={lang} />
      <FdCta lang={lang} />
    </>
  )}

  {routeKey === 'references' && (
    <>
      <FdReferencesHero
        lang={lang}
        eyebrow={copy.pages.references.hero.eyebrow}
        title={copy.pages.references.hero.title}
        subtitle={copy.pages.references.hero.subtitle}
        primaryLabel={copy.pages.references.hero.primaryLabel}
        primaryHref={getRoutePath('contact', lang)}
        secondaryLabel={copy.pages.references.hero.secondaryLabel}
        secondaryHref={getRoutePath('process', lang)}
      />
      <ReferencesShowcase lang={lang} />
      <FdCta lang={lang} />
    </>
  )}

  {routeKey === 'about' && (
    <>
      <FdAboutHero
        lang={lang}
        eyebrow={copy.pages.about.hero.eyebrow}
        title={copy.pages.about.hero.title}
        subtitle={copy.pages.about.hero.subtitle}
        primaryLabel={copy.pages.about.hero.primaryLabel}
        primaryHref={getRoutePath('contact', lang)}
        secondaryLabel={copy.pages.about.hero.secondaryLabel}
        secondaryHref={getRoutePath('references', lang)}
      />
      <FdAbout lang={lang} />
      <FdCta lang={lang} />
    </>
  )}

  {routeKey === 'contact' && <ContactView lang={lang} />}

  {routeKey === 'privacy' && <LegalContent content={legal.privacy} />}

  {routeKey === 'cookies' && <LegalContent content={legal.cookies} />}
</BaseLayout>

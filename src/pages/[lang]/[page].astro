---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/sections/Hero.astro';
import TrustBadges from '../../components/sections/TrustBadges.astro';
import Services from '../../components/sections/Services.astro';
import ValueProps from '../../components/sections/ValueProps.astro';
import Capabilities from '../../components/sections/Capabilities.astro';
import Partners from '../../components/sections/Partners.astro';
import Process from '../../components/sections/Process.astro';
import Faq from '../../components/sections/Faq.astro';
import Cta from '../../components/sections/Cta.astro';
import ReferencesShowcase from '../../components/sections/ReferencesShowcase.astro';
import Container from '../../components/Container.astro';
import SectionHeading from '../../components/SectionHeading.astro';
import { site } from '../../data/site';
import { languages, defaultLang, isSupportedLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';
import { getRoutePath, getRouteKeyFromPath, pageKeys } from '../../i18n/routes';

export function getStaticPaths() {
  return languages
    .filter((item) => item.code !== defaultLang)
    .flatMap((item) =>
      pageKeys.map((key) => {
        const fullPath = getRoutePath(key, item.code);
        const segments = fullPath.split('/').filter(Boolean);
        const slug = segments.slice(1).join('/');
        return {
          params: { lang: item.code, page: slug },
          props: { routeKey: key },
        };
      })
    );
}

const { lang, page } = Astro.params;
if (!lang || !isSupportedLang(lang) || lang === defaultLang) {
  throw new Error('Unsupported language');
}

const routeKey = Astro.props.routeKey ?? getRouteKeyFromPath(`/${lang}/${page}`);
if (!routeKey || routeKey === 'home' || routeKey === 'blog') {
  throw new Error('Unknown page');
}

const copy = getCopy(lang);
const metaMap = {
  services: copy.pages.services.meta,
  process: copy.pages.process.meta,
  references: copy.pages.references.meta,
  about: copy.pages.about.meta,
  contact: copy.pages.contact.meta,
};

const meta = metaMap[routeKey];
---

<BaseLayout lang={lang} title={meta.title} description={meta.description}>
  {routeKey === 'services' && (
    <>
      <Hero
        lang={lang}
        eyebrow={copy.pages.services.hero.eyebrow}
        title={copy.pages.services.hero.title}
        subtitle={copy.pages.services.hero.subtitle}
        primaryLabel={copy.pages.services.hero.primaryLabel}
        primaryHref={getRoutePath('contact', lang)}
        secondaryLabel={copy.pages.services.hero.secondaryLabel}
        secondaryHref={getRoutePath('process', lang)}
      />
      <TrustBadges lang={lang} />
      <Services lang={lang} />
      <Partners lang={lang} />
      <Capabilities lang={lang} />
      <ValueProps lang={lang} />
      <Cta lang={lang} />
    </>
  )}

  {routeKey === 'process' && (
    <>
      <Hero
        lang={lang}
        eyebrow={copy.pages.process.hero.eyebrow}
        title={copy.pages.process.hero.title}
        subtitle={copy.pages.process.hero.subtitle}
        primaryLabel={copy.pages.process.hero.primaryLabel}
        primaryHref={getRoutePath('contact', lang)}
        secondaryLabel={copy.pages.process.hero.secondaryLabel}
        secondaryHref={getRoutePath('services', lang)}
      />
      <Process lang={lang} />
      <Faq lang={lang} />
      <Cta lang={lang} />
    </>
  )}

  {routeKey === 'references' && (
    <>
      <Hero
        lang={lang}
        eyebrow={copy.pages.references.hero.eyebrow}
        title={copy.pages.references.hero.title}
        subtitle={copy.pages.references.hero.subtitle}
        primaryLabel={copy.pages.references.hero.primaryLabel}
        primaryHref={getRoutePath('contact', lang)}
        secondaryLabel={copy.pages.references.hero.secondaryLabel}
        secondaryHref={getRoutePath('process', lang)}
      />
      <ReferencesShowcase lang={lang} />
      <Cta lang={lang} />
    </>
  )}

  {routeKey === 'about' && (
    <>
      <Hero
        lang={lang}
        eyebrow={copy.pages.about.hero.eyebrow}
        title={copy.pages.about.hero.title}
        subtitle={copy.pages.about.hero.subtitle}
        primaryLabel={copy.pages.about.hero.primaryLabel}
        primaryHref={getRoutePath('contact', lang)}
        secondaryLabel={copy.pages.about.hero.secondaryLabel}
        secondaryHref={getRoutePath('references', lang)}
      />

      <section class="py-20 sm:py-24">
        <Container class="space-y-12">
          <SectionHeading
            eyebrow={copy.pages.about.values.eyebrow}
            title={copy.pages.about.values.title}
            subtitle={copy.pages.about.values.subtitle}
          />
          <div class="grid gap-6 md:grid-cols-3">
            {copy.pages.about.values.items.map((item) => (
              <div class="card card-3d h-full">
                <h3 class="font-display text-xl">{item.title}</h3>
                <p class="mt-4 text-sm text-mist">{item.description}</p>
              </div>
            ))}
          </div>
        </Container>
      </section>

      <section class="py-20 sm:py-24">
        <Container class="space-y-12">
          <SectionHeading
            eyebrow={copy.pages.about.team.eyebrow}
            title={copy.pages.about.team.title}
            subtitle={copy.pages.about.team.subtitle}
          />
          <div class="grid gap-6 md:grid-cols-3">
            {copy.pages.about.team.items.map((item) => (
              <div class="card card-3d h-full">
                <p class="text-xs uppercase tracking-[0.3em] text-aqua/80">{item.label}</p>
                <h3 class="mt-3 font-display text-xl">{item.title}</h3>
                <p class="mt-4 text-sm text-mist">{item.description}</p>
              </div>
            ))}
          </div>
        </Container>
      </section>

      <Cta lang={lang} />
    </>
  )}

  {routeKey === 'contact' && (
    <>
      <Hero
        lang={lang}
        eyebrow={copy.pages.contact.hero.eyebrow}
        title={copy.pages.contact.hero.title}
        subtitle={copy.pages.contact.hero.subtitle}
        primaryLabel={copy.pages.contact.hero.primaryLabel}
        primaryHref={`mailto:${site.email}`}
        secondaryLabel={copy.pages.contact.hero.secondaryLabel}
        secondaryHref={getRoutePath('services', lang)}
      />

      <section class="py-20 sm:py-24">
        <Container class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr]">
          <div class="space-y-8">
            <SectionHeading
              eyebrow={copy.pages.contact.formHeading.eyebrow}
              title={copy.pages.contact.formHeading.title}
              subtitle={copy.pages.contact.formHeading.subtitle}
            />
            <form class="grid gap-4" name="kontakt" method="POST" data-netlify="true">
              <input type="hidden" name="form-name" value="kontakt" />
              <input type="hidden" name="recipient" value={site.email} />
              <input type="hidden" name="subject" value="New contact inquiry" />
              <label class="grid gap-2 text-sm text-mist">
                {copy.pages.contact.formLabels.name}
                <input
                  class="input-field"
                  name="meno"
                  placeholder={copy.pages.contact.formLabels.namePlaceholder}
                  required
                />
              </label>
              <label class="grid gap-2 text-sm text-mist">
                {copy.pages.contact.formLabels.email}
                <input
                  class="input-field"
                  name="email"
                  type="email"
                  placeholder={copy.pages.contact.formLabels.emailPlaceholder}
                  required
                />
              </label>
              <label class="grid gap-2 text-sm text-mist">
                {copy.pages.contact.formLabels.message}
                <textarea
                  class="input-field min-h-[140px]"
                  name="sprava"
                  placeholder={copy.pages.contact.formLabels.messagePlaceholder}
                  required
                ></textarea>
              </label>
              <button class="btn-primary w-full sm:w-auto" type="submit">
                {copy.pages.contact.formLabels.submit}
              </button>
              <p class="text-xs text-mist">{copy.pages.contact.formLabels.consent}</p>
            </form>
          </div>

          <div class="space-y-6">
            <SectionHeading
              eyebrow={copy.pages.contact.directHeading.eyebrow}
              title={copy.pages.contact.directHeading.title}
              subtitle={copy.pages.contact.directHeading.subtitle}
            />
            <div class="card space-y-4">
              <div>
                <p class="text-xs uppercase tracking-[0.3em] text-aqua/80">{copy.pages.contact.directLabels.email}</p>
                <a class="mt-2 block text-lg text-ice" href={`mailto:${site.email}`}>{site.email}</a>
              </div>
              <div>
                <p class="text-xs uppercase tracking-[0.3em] text-aqua/80">{copy.pages.contact.directLabels.phone}</p>
                <a class="mt-2 block text-lg text-ice" href={`tel:${site.phone.replace(/\s/g, '')}`}>
                  {site.phone}
                </a>
              </div>
              <div>
                <p class="text-xs uppercase tracking-[0.3em] text-aqua/80">{copy.pages.contact.directLabels.location}</p>
                <p class="mt-2 text-sm text-mist">{site.address}</p>
              </div>
            </div>
            <div class="card">
              <p class="text-xs uppercase tracking-[0.3em] text-aqua/80">{copy.pages.contact.directLabels.scope}</p>
              <p class="mt-3 text-sm text-mist">{copy.pages.contact.directLabels.scopeText}</p>
            </div>
          </div>
        </Container>
      </section>
    </>
  )}
</BaseLayout>

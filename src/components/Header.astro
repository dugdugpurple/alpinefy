---
import Container from './Container.astro';
import Logo from './Logo.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import HeaderMegaMenu from './HeaderMegaMenu.astro';
import ThemeToggle from './ThemeToggle.astro';
import SocialIcons from './SocialIcons.astro';
import { site } from '../data/site';
import { defaultLang } from '../i18n/languages';
import { getCopy, navItems } from '../i18n/copy';
import { getRoutePath } from '../i18n/routes';
import { getServiceAnchor, getServiceKeyByIndex } from '../data/services-funnel';

const { lang = defaultLang } = Astro.props;
const currentPath = Astro.url.pathname;
const normalizedPath =
  currentPath !== '/' && currentPath.endsWith('/') ? currentPath.slice(0, -1) : currentPath;
const copy = getCopy(lang);
const consultationHref = `${getRoutePath('contact', lang)}#kontakt-formular`;
// Career lives only in the footer — keep it out of the header nav.
const headerNavItems = navItems.filter((link) => link.key !== 'career');
// Services má vlastné mega-menu, v plochom zozname sa preskočí.
const flatNavItems = headerNavItems.filter((link) => link.key !== 'services');
const servicesHref = getRoutePath('services', lang);
const megaServiceLinks = copy.sections.services.items.map((service, index) => ({
  title: service.title,
  href: `${servicesHref}#${getServiceAnchor(getServiceKeyByIndex(index)).id}`,
}));

// Cookie-settings label for the mobile menu (mirrors CookieBanner's reopen label);
// on mobile the floating dock button is hidden and this menu item reopens it.
const cookieLabelByLang: Record<string, string> = {
  en: 'Cookie settings',
  de: 'Cookie-Einstellungen',
  pl: 'Ustawienia cookies',
  cz: 'Nastavení cookies',
  sk: 'Nastavenia cookies',
};
const cookieLabel = cookieLabelByLang[lang] ?? cookieLabelByLang.en;
---

<header id="site-header" class="site-header fixed inset-x-0 top-0 z-50" data-scrolled="false">
  <div class="header-shell">
    <Container class="flex items-center justify-between py-4">
      <a href={getRoutePath('home', lang)} class="group flex items-center gap-3">
        <span class="logo-mark inline-flex h-11 w-11 items-center justify-center rounded-2xl">
          <Logo class="h-6 w-6" />
        </span>
        <div class="leading-tight">
          <p class="font-display text-lg font-semibold">{site.name}</p>
          <p class="text-[11px] uppercase tracking-[0.25em] text-mist/80">AI & Web Studio</p>
        </div>
      </a>

      <nav class="hidden items-center gap-7 md:flex">
        <HeaderMegaMenu lang={lang} normalizedPath={normalizedPath} />
        {flatNavItems.map((link) => {
          const href = getRoutePath(link.route, lang);
          return (
            <a href={href} class={`nav-link ${normalizedPath === href ? 'is-active' : ''}`}>
              {copy.nav[link.key]}
            </a>
          );
        })}
      </nav>

      <div class="hidden items-center gap-3 md:flex">
        <LanguageSwitcher lang={lang} />
        <ThemeToggle />
        <a class="btn-primary" href={consultationHref}>
          {copy.sections.cta.primaryLabel}
        </a>
      </div>

      <div class="relative md:hidden">
        <button
          id="menu-open"
          type="button"
          class="menu-button relative z-[80] inline-flex h-11 w-11 flex-col items-center justify-center gap-1.5 rounded-full border border-white/20 bg-coal/75 text-ice/80 transition hover:text-ice"
          aria-controls="mobile-menu"
          aria-expanded="false"
          data-menu-open
        >
          <span class="sr-only">{copy.menu.openLabel}</span>
          <span class="menu-line block h-0.5 w-5 bg-ice" data-line="1"></span>
          <span class="menu-line block h-0.5 w-5 bg-ice" data-line="2"></span>
          <span class="menu-line block h-0.5 w-5 bg-ice" data-line="3"></span>
        </button>
      </div>
    </Container>
  </div>

  <div class="md:hidden">
    <div id="mobile-menu" class="mobile-menu fixed inset-0 z-[70]" data-open="false" aria-hidden="true" inert>
      <div class="absolute inset-0 bg-night/88 backdrop-blur-sm" data-menu-close></div>
      <div class="mobile-menu-panel absolute inset-4 flex h-[calc(100%-2rem)] w-[calc(100%-2rem)] flex-col gap-6 overflow-y-auto rounded-3xl border border-white/15 bg-gradient-to-b from-graphite/95 via-coal/95 to-night/95 p-6 pb-8 shadow-2xl transition duration-300">
        <div class="flex items-center justify-between">
          <a href={getRoutePath('home', lang)} class="flex items-center gap-3" data-menu-close>
            <span class="logo-mark inline-flex h-10 w-10 items-center justify-center rounded-xl">
              <Logo class="h-6 w-6" />
            </span>
            <span class="font-display text-lg">{site.name}</span>
          </a>
          <button
            type="button"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 px-4 py-2 text-[11px] uppercase tracking-[0.25em] text-mist transition hover:text-ice"
            data-menu-close
          >
            {copy.menu.closeLabel}
          </button>
        </div>

        <nav class="grid gap-2 text-base">
          <div>
            <button
              type="button"
              class="flex w-full items-center justify-between rounded-2xl border border-transparent px-4 py-3 text-left text-ice/85 transition hover:border-white/15 hover:bg-white/5 hover:text-ice"
              data-m-acc-trigger
              aria-expanded="false"
              aria-controls="mobile-acc-services"
            >
              {copy.nav.services}
              <svg
                viewBox="0 0 24 24"
                class="h-4 w-4 transition-transform duration-200"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
                data-m-acc-arrow
              >
                <path d="m6 9 6 6 6-6"></path>
              </svg>
            </button>
            <div id="mobile-acc-services" class="m-acc-panel" data-m-acc-panel data-open="false">
              <div class="grid gap-1 pb-1 pl-3 pt-1">
                {megaServiceLinks.map((link) => (
                  <a
                    href={link.href}
                    class="rounded-xl px-4 py-2.5 text-sm text-ice/75 transition hover:bg-white/5 hover:text-ice"
                    data-menu-close
                  >
                    {link.title}
                  </a>
                ))}
                <a
                  href={`${servicesHref}#pricing`}
                  class="rounded-xl px-4 py-2.5 text-sm text-aqua transition hover:bg-white/5"
                  data-menu-close
                >
                  {copy.megaMenu.calculator}
                </a>
              </div>
            </div>
          </div>
          {flatNavItems.map((link) => (
            <a
              href={getRoutePath(link.route, lang)}
              class="rounded-2xl border border-transparent px-4 py-3 text-ice/85 transition hover:border-white/15 hover:bg-white/5 hover:text-ice"
              data-menu-close
            >
              {copy.nav[link.key]}
            </a>
          ))}
        </nav>

        <div class="mt-auto space-y-4 text-sm text-mist">
          <div class="flex items-center justify-between">
            <LanguageSwitcher lang={lang} direction="up" mobile={true} />
            <ThemeToggle />
          </div>
          <a class="btn-primary w-full" href={consultationHref} data-menu-close>
            {copy.sections.cta.primaryLabel}
          </a>
          <p class="text-xs">{copy.sections.cta.note}</p>
          <button
            type="button"
            class="inline-flex items-center gap-2 self-start text-xs text-mist transition hover:text-ice"
            data-menu-close
            data-cookie-open
          >
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3a9 9 0 1 0 9 9 3.5 3.5 0 0 1-4.5-4.5A3.5 3.5 0 0 1 12 3Z" />
              <path d="M9.5 12h.01M13 15h.01M15 10.5h.01" />
            </svg>
            {cookieLabel}
          </button>
          <SocialIcons class="pt-2" lang={lang} />
        </div>
      </div>
    </div>

    <script is:inline>
      const initMobileMenu = () => {
        const menu = document.getElementById('mobile-menu');
        const openButton = document.querySelector('[data-menu-open]');
        if (!menu || !openButton || menu.dataset.ready === 'true') return;
        menu.dataset.ready = 'true';

        const closeButtons = menu.querySelectorAll('[data-menu-close]');
        const accTrigger = menu.querySelector('[data-m-acc-trigger]');
        const accPanel = menu.querySelector('[data-m-acc-panel]');
        const accArrow = menu.querySelector('[data-m-acc-arrow]');

        // Akordeón Services v mobilnom menu.
        const setAccOpen = (isOpen) => {
          if (!accTrigger || !accPanel) return;
          accTrigger.setAttribute('aria-expanded', String(isOpen));
          if (accArrow) {
            accArrow.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
          }
          // Výšku animuje CSS cez data-open (grid-template-rows).
          accPanel.setAttribute('data-open', String(isOpen));
        };

        if (accTrigger) {
          accTrigger.addEventListener('click', () => {
            setAccOpen(accTrigger.getAttribute('aria-expanded') !== 'true');
          });
        }

        const setMenuOpen = (isOpen) => {
          menu.setAttribute('data-open', String(isOpen));
          menu.setAttribute('aria-hidden', String(!isOpen));
          if (isOpen) {
            menu.removeAttribute('inert');
          } else {
            menu.setAttribute('inert', '');
          }
          openButton.setAttribute('aria-expanded', String(isOpen));
          openButton.classList.toggle('is-open', isOpen);
          openButton.classList.toggle('opacity-0', isOpen);
          openButton.classList.toggle('pointer-events-none', isOpen);
          document.body.style.overflow = isOpen ? 'hidden' : '';
          // Po zavretí menu sa akordeón zloží, nabudúce sa otvorí čistý.
          if (!isOpen) setAccOpen(false);
        };

        openButton.addEventListener('click', () => setMenuOpen(true));
        closeButtons.forEach((button) => button.addEventListener('click', () => setMenuOpen(false)));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape') setMenuOpen(false);
        });
      };

      const initHeaderScroll = () => {
        const header = document.getElementById('site-header');
        if (!header) return;

        const syncHeaderState = () => {
          header.setAttribute('data-scrolled', window.scrollY > 10 ? 'true' : 'false');
        };

        syncHeaderState();
        if (header.dataset.scrollReady === 'true') return;
        header.dataset.scrollReady = 'true';

        let ticking = false;
        window.addEventListener(
          'scroll',
          () => {
            if (ticking) return;
            ticking = true;
            requestAnimationFrame(() => {
              syncHeaderState();
              ticking = false;
            });
          },
          { passive: true }
        );
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', () => {
          initMobileMenu();
          initHeaderScroll();
        });
      } else {
        initMobileMenu();
        initHeaderScroll();
      }

      document.addEventListener('astro:page-load', () => {
        initMobileMenu();
        initHeaderScroll();
      });
    </script>
  </div>
</header>

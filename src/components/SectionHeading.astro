---
const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
const alignClass = align === 'center' ? 'items-center text-center' : 'items-start text-left';
---

<div class={`flex max-w-3xl flex-col gap-4 motion-safe:animate-fadeUp ${alignClass}`}>
  {eyebrow && (
    <div class="flex items-center gap-3">
      <span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>
      <p class="text-xs font-semibold uppercase tracking-[0.3em] text-aqua/90">{eyebrow}</p>
      <span class="h-px w-12 bg-gradient-to-r from-aqua/80 to-transparent"></span>
    </div>
  )}
  {title && (
    <h2 class="font-display text-3xl leading-tight sm:text-4xl lg:text-5xl">{title}</h2>
  )}
  {subtitle && (
    <p class="max-w-2xl text-base text-mist sm:text-lg">{subtitle}</p>
  )}
</div>

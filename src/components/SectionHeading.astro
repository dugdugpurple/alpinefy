---
const { eyebrow, title, subtitle, align = 'left' } = Astro.props;
const alignClass = align === 'center' ? 'items-center text-center' : 'items-start text-left';
---

<div class={`flex max-w-3xl flex-col gap-5 motion-safe:animate-fadeUp ${alignClass}`}>
  {eyebrow && (
    <div class="flex items-center gap-2.5">
      <span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>
      <p class="text-[11px] font-semibold uppercase tracking-[0.32em] text-mist">{eyebrow}</p>
    </div>
  )}
  {title && (
    <h2 class="font-display text-4xl font-bold leading-[1.03] tracking-[-0.035em] sm:text-5xl lg:text-[3.3rem]">{title}</h2>
  )}
  {subtitle && (
    <p class="max-w-2xl text-base text-mist sm:text-lg">{subtitle}</p>
  )}
</div>

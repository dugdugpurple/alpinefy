---
import Container from '../Container.astro';
import FdHeading from '../sections/FdHeading.astro';
import { attributionFieldNames, getContactIntakeCopy } from '../../data/contact-intake';
import { getDisplayPhone, getPhoneDialValue, site } from '../../data/site';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';
import { getRoutePath } from '../../i18n/routes';

interface Props {
  lang?: string;
}
const { lang = defaultLang } = Astro.props;

const copy = getCopy(lang);
const contactFormName = 'contact-inquiry';
const currentPath = Astro.url.pathname;
const phoneLabel = getDisplayPhone(lang);
const phoneDial = getPhoneDialValue();
const intake = getContactIntakeCopy(lang);

// Response-promise strings that live only in this view (not in copy.ts).
type Promise = {
  replyBadge: string; online: string; monFri: string;
  avgLabel: string; avgValue: string; personal: string; checks: [string, string, string];
};
const promiseByLang: Record<string, Promise> = {
  en: {
    replyBadge: 'Reply within 24 hours', online: 'Online', monFri: 'Mon – Fri',
    avgLabel: 'Average reply time', avgValue: 'Within 24h',
    personal: 'A fast first reply, then I take it over personally — no queue tickets.',
    checks: ['Free intro call', 'Clear next steps', 'No pressure, no spam'],
  },
  de: {
    replyBadge: 'Antwort innerhalb von 24 Stunden', online: 'Online', monFri: 'Mo – Fr',
    avgLabel: 'Durchschnittliche Antwortzeit', avgValue: 'Innerhalb von 24 h',
    personal: 'Eine schnelle erste Antwort, dann kümmere ich mich persönlich darum — keine Ticket-Warteschlange.',
    checks: ['Kostenloses Erstgespräch', 'Klare nächste Schritte', 'Kein Druck, kein Spam'],
  },
  pl: {
    replyBadge: 'Odpowiedź w ciągu 24 godzin', online: 'Online', monFri: 'Pon – Pt',
    avgLabel: 'Średni czas odpowiedzi', avgValue: 'W ciągu 24 h',
    personal: 'Szybka pierwsza odpowiedź, a potem zajmuję się tym osobiście — bez kolejki zgłoszeń.',
    checks: ['Bezpłatna rozmowa wstępna', 'Jasne kolejne kroki', 'Bez presji, bez spamu'],
  },
  cz: {
    replyBadge: 'Odpověď do 24 hodin', online: 'Online', monFri: 'Po – Pá',
    avgLabel: 'Průměrná doba odpovědi', avgValue: 'Do 24 h',
    personal: 'Rychlá první odpověď, pak se toho ujmu osobně — žádná fronta tiketů.',
    checks: ['Nezávazná úvodní konzultace', 'Jasné další kroky', 'Žádný tlak, žádný spam'],
  },
  sk: {
    replyBadge: 'Odpoveď do 24 hodín', online: 'Online', monFri: 'Po – Pi',
    avgLabel: 'Priemerný čas odpovede', avgValue: 'Do 24 h',
    personal: 'Rýchla prvá odpoveď, potom sa toho ujmem osobne — žiadna fronta tiketov.',
    checks: ['Nezáväzná úvodná konzultácia', 'Jasné ďalšie kroky', 'Žiadny tlak, žiadny spam'],
  },
};
const p = promiseByLang[lang] ?? promiseByLang.en;

// Icons for the direct-contact tiles (aqua line glyphs).
const mailIcon = '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="m4 7 8 6 8-6"/>';
const phoneIcon = '<path d="M4 5c0-1 .8-1.8 1.8-1.8h1.6c.8 0 1.5.5 1.7 1.3l.7 2.3c.2.7 0 1.4-.5 1.9l-1.1 1.1a13 13 0 0 0 5.5 5.5l1.1-1.1c.5-.5 1.2-.7 1.9-.5l2.3.7c.8.2 1.3.9 1.3 1.7v1.6c0 1-.8 1.8-1.8 1.8A16 16 0 0 1 4 5Z"/>';
const pinIcon = '<path d="M12 21s7-5.4 7-11a7 7 0 1 0-14 0c0 5.6 7 11 7 11Z"/><circle cx="12" cy="10" r="2.6"/>';
const scopeIcon = '<circle cx="12" cy="12" r="9"/><path d="M12 3a15 15 0 0 1 0 18M12 3a15 15 0 0 0 0 18M3 12h18"/>';
---

<!-- HERO: get in touch -->
<section class="contact-hero relative overflow-hidden pb-14 pt-32 sm:pb-20 sm:pt-40">
  <div class="contact-hero-glow pointer-events-none absolute inset-0" aria-hidden="true"></div>
  <Container class="relative">
    <div class="grid items-center gap-12 lg:grid-cols-[1.05fr_0.95fr] lg:gap-14">
      <!-- LEFT: headline + CTA -->
      <div class="relative z-10">
        <span class="inline-flex items-center gap-2.5 rounded-full border border-white/10 bg-white/[0.03] px-4 py-1.5 text-[11px] font-semibold uppercase tracking-[0.3em] text-mist motion-safe:animate-fadeUp">
          <span class="h-1.5 w-1.5 rounded-full bg-aqua shadow-[0_0_12px_2px_rgba(38,202,255,0.8)]"></span>
          {copy.pages.contact.hero.eyebrow}
        </span>
        <h1
          class="mt-7 font-display text-5xl font-bold leading-[0.94] tracking-[-0.045em] text-ice sm:text-6xl lg:text-[4.75rem] motion-safe:animate-fadeUp"
          style="animation-delay: 70ms;"
        >
          {copy.pages.contact.hero.title}
        </h1>
        <p class="mt-7 max-w-xl text-lg leading-relaxed text-mist motion-safe:animate-fadeUp" style="animation-delay: 140ms;">
          {copy.pages.contact.hero.subtitle}
        </p>

        <div class="mt-8 flex flex-wrap items-center gap-3 motion-safe:animate-fadeUp" style="animation-delay: 190ms;">
          <span class="inline-flex items-center gap-2 rounded-full border border-lime/30 bg-lime/[0.08] px-3.5 py-1.5 text-xs font-semibold text-lime">
            <span class="contact-live-dot" aria-hidden="true"></span>
            {p.replyBadge}
          </span>
          <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-coal/50 px-3.5 py-1.5 text-xs font-medium text-ice/80">
            <span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>
            {site.address}
          </span>
        </div>

        <div class="mt-9 flex flex-wrap gap-3 motion-safe:animate-fadeUp" style="animation-delay: 240ms;">
          <a class="btn-primary" href={`${getRoutePath('contact', lang)}#kontakt-formular`}>{copy.pages.contact.hero.primaryLabel}</a>
          <a class="btn-secondary" href={getRoutePath('services', lang)}>{copy.pages.contact.hero.secondaryLabel}</a>
        </div>
      </div>

      <!-- RIGHT: response promise card -->
      <div class="relative motion-safe:animate-fadeUp" style="animation-delay: 200ms;">
        <div class="contact-hero-card relative overflow-hidden rounded-[2rem] border border-white/10 p-2.5">
          <div class="rounded-[1.6rem] border border-white/[0.06] bg-night/70 p-6 sm:p-7">
            <div class="flex items-center justify-between gap-3">
              <span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.24em] text-lime">
                <span class="contact-live-dot" aria-hidden="true"></span>
                {p.online}
              </span>
              <span class="inline-flex items-center gap-2 rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-[10px] tracking-wide text-mist">
                <span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>
                {p.monFri}
              </span>
            </div>

            <p class="mt-6 text-[10px] font-semibold uppercase tracking-[0.3em] text-aqua/90">{p.avgLabel}</p>
            <p class="mt-1.5 font-display text-4xl font-bold tracking-[-0.04em] text-ice sm:text-5xl">{p.avgValue}</p>
            <p class="mt-2 text-sm leading-relaxed text-mist">{p.personal}</p>

            <ul class="mt-6 space-y-3 border-t border-white/10 pt-6">
              {p.checks.map((item) => (
                <li class="flex items-center gap-3 text-sm text-ice/85">
                  <span class="contact-check" aria-hidden="true">
                    <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5" /></svg>
                  </span>
                  {item}
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<!-- FORM + DIRECT CONTACT -->
<section class="pb-20 sm:pb-28">
  <Container class="grid gap-12 lg:grid-cols-[1.2fr_0.8fr]">
    <div class="space-y-8" id="kontakt-formular">
      <FdHeading
        eyebrow={copy.pages.contact.formHeading.eyebrow}
        title={copy.pages.contact.formHeading.title}
        subtitle={copy.pages.contact.formHeading.subtitle}
      />
      <form
        class="grid gap-4"
        name={contactFormName}
        method="POST"
        netlify
        netlify-honeypot="bot-field"
        data-netlify="true"
        data-netlify-honeypot="bot-field"
        data-capture-attribution="true"
        action={`${getRoutePath('thankYou', lang)}?src=contact&lang=${lang}`}
      >
        <input type="hidden" name="form-name" value={contactFormName} />
        <p class="hidden">
          <label>
            Don’t fill this out if you’re human: <input name="bot-field" />
          </label>
        </p>
        <input type="hidden" name="recipient" value={site.email} />
        <input type="hidden" name="subject" value="New qualified contact inquiry" />
        <input type="hidden" name="locale" value={lang} />
        <input type="hidden" name="source_page" value={currentPath} />
        {attributionFieldNames.map((field) => (
          <input type="hidden" name={field} value="" data-attribution-field={field} />
        ))}
        <label class="grid gap-2 text-sm text-mist">
          {copy.pages.contact.formLabels.name}
          <input class="input-field" name="meno" placeholder={copy.pages.contact.formLabels.namePlaceholder} required />
        </label>
        <label class="grid gap-2 text-sm text-mist">
          {copy.pages.contact.formLabels.email}
          <input class="input-field" name="email" type="email" placeholder={copy.pages.contact.formLabels.emailPlaceholder} required />
        </label>
        <div class="grid gap-4 sm:grid-cols-2">
          <label class="grid gap-2 text-sm text-mist">
            {intake.serviceLabel}
            <select class="input-field" name="service_interest" required>
              <option value="" selected disabled>{intake.servicePlaceholder}</option>
              {intake.serviceOptions.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </label>
          <label class="grid gap-2 text-sm text-mist">
            {intake.budgetLabel}
            <select class="input-field" name="budget_range" required>
              <option value="" selected disabled>{intake.budgetPlaceholder}</option>
              {intake.budgetOptions.map((option) => (
                <option value={option.value}>{option.label}</option>
              ))}
            </select>
          </label>
        </div>
        <label class="grid gap-2 text-sm text-mist">
          {intake.timelineLabel}
          <select class="input-field" name="timeline_preference" required>
            <option value="" selected disabled>{intake.timelinePlaceholder}</option>
            {intake.timelineOptions.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>
        <label class="grid gap-2 text-sm text-mist">
          {intake.websiteLabel}
          <input class="input-field" name="current_website" type="url" inputmode="url" placeholder={intake.websitePlaceholder} />
        </label>
        <label class="grid gap-2 text-sm text-mist">
          {copy.pages.contact.formLabels.message}
          <textarea class="input-field min-h-[140px]" name="sprava" placeholder={copy.pages.contact.formLabels.messagePlaceholder} required></textarea>
        </label>
        <button class="btn-primary w-full sm:w-auto" type="submit">{copy.pages.contact.formLabels.submit}</button>
        <p class="text-xs text-mist">{copy.pages.contact.formLabels.consent}</p>
      </form>
    </div>

    <div class="space-y-6">
      <FdHeading
        eyebrow={copy.pages.contact.directHeading.eyebrow}
        title={copy.pages.contact.directHeading.title}
        subtitle={copy.pages.contact.directHeading.subtitle}
      />

      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
        <a class="contact-tile group" href={`mailto:${site.email}`}>
          <span class="contact-tile-icon">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={mailIcon}></svg>
          </span>
          <div class="min-w-0">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-mist">{copy.pages.contact.directLabels.email}</p>
            <p class="mt-1.5 truncate text-lg text-ice transition group-hover:text-aqua">{site.email}</p>
          </div>
        </a>

        <a class="contact-tile group" href={`tel:${phoneDial}`}>
          <span class="contact-tile-icon">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={phoneIcon}></svg>
          </span>
          <div class="min-w-0">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-mist">{copy.pages.contact.directLabels.phone}</p>
            <p class="mt-1.5 text-lg text-ice transition group-hover:text-aqua">{phoneLabel}</p>
          </div>
        </a>

        <div class="contact-tile">
          <span class="contact-tile-icon">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={pinIcon}></svg>
          </span>
          <div class="min-w-0">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-mist">{copy.pages.contact.directLabels.location}</p>
            <p class="mt-1.5 text-sm text-mist">{site.address}</p>
          </div>
        </div>

        <div class="contact-tile">
          <span class="contact-tile-icon">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" set:html={scopeIcon}></svg>
          </span>
          <div class="min-w-0">
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-mist">{copy.pages.contact.directLabels.scope}</p>
            <p class="mt-1.5 text-sm text-mist">{copy.pages.contact.directLabels.scopeText}</p>
          </div>
        </div>
      </div>
    </div>
  </Container>
</section>

<style>
  .contact-hero-glow {
    background:
      radial-gradient(720px circle at 80% 6%, rgba(var(--color-aqua) / 0.16), transparent 55%),
      radial-gradient(560px circle at 8% 2%, rgba(var(--color-lime) / 0.08), transparent 60%);
  }
  .contact-hero-card {
    background:
      linear-gradient(155deg, rgba(var(--color-aqua) / 0.14), transparent 45%),
      linear-gradient(320deg, rgba(var(--color-lime) / 0.1), transparent 42%),
      rgba(var(--color-coal) / 0.7);
    box-shadow:
      0 0 0 1px rgba(var(--color-aqua) / 0.08),
      0 40px 120px -40px rgba(0, 0, 0, 0.9),
      0 0 90px -30px rgba(var(--color-aqua) / 0.4);
  }
  .contact-live-dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 999px;
    background: rgb(var(--color-lime));
    box-shadow: 0 0 0 0 rgba(var(--color-lime) / 0.55);
    animation: contactLivePulse 2.1s ease-out infinite;
  }
  .contact-check {
    display: inline-flex;
    height: 1.15rem;
    width: 1.15rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 0.5rem;
    color: rgb(var(--color-on-accent));
    background: linear-gradient(150deg, rgb(var(--color-lime)), rgba(var(--color-aqua) / 0.9));
    box-shadow: 0 6px 16px -6px rgba(var(--color-lime) / 0.7);
  }
  .contact-tile {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    border-radius: 1.5rem;
    border: 1px solid rgba(var(--color-ice) / 0.1);
    background: rgba(var(--color-coal) / 0.5);
    padding: 1.25rem 1.35rem;
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  a.contact-tile:hover {
    transform: translateY(-4px);
    border-color: rgba(var(--color-aqua) / 0.4);
    box-shadow: 0 0 0 1px rgba(var(--color-aqua) / 0.2), 0 24px 52px -30px rgba(0, 0, 0, 0.85);
  }
  .contact-tile-icon {
    display: inline-flex;
    height: 3rem;
    width: 3rem;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 1rem;
    color: rgb(var(--color-aqua));
    border: 1px solid rgba(var(--color-aqua) / 0.25);
    background: rgba(var(--color-aqua) / 0.1);
    box-shadow: 0 10px 30px -12px rgba(var(--color-aqua) / 0.7);
  }
  @keyframes contactLivePulse {
    0% { box-shadow: 0 0 0 0 rgba(var(--color-lime) / 0.5); }
    70% { box-shadow: 0 0 0 7px rgba(var(--color-lime) / 0); }
    100% { box-shadow: 0 0 0 0 rgba(var(--color-lime) / 0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-live-dot { animation: none !important; }
    a.contact-tile:hover { transform: none; }
  }
</style>

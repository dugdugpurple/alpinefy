---
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';
import type { LegalPageContent } from '../../i18n/legal';

const { content } = Astro.props as { content: LegalPageContent };
---

<section class="pb-20 pt-32 sm:pb-24 sm:pt-36">
  <Container class="space-y-10">
    <SectionHeading
      eyebrow={content.heading.eyebrow}
      title={content.heading.title}
      subtitle={content.heading.subtitle}
    />

    <div class="card rounded-2xl p-4 sm:p-5">
      <p class="text-xs uppercase tracking-[0.22em] text-aqua/85">{content.lastUpdatedLabel}</p>
      <p class="mt-2 text-sm text-ice">{content.lastUpdatedDate}</p>
    </div>

    <div class="grid gap-5 sm:gap-6">
      {content.sections.map((section) => (
        <article class="card rounded-2xl p-5 sm:p-6">
          <h3 class="font-display text-xl text-ice sm:text-2xl">{section.title}</h3>
          <div class="mt-4 space-y-3 text-sm leading-relaxed text-mist sm:text-[15px]">
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          {section.bullets && section.bullets.length > 0 && (
            <ul class="mt-4 grid gap-2 text-sm text-mist sm:text-[15px]">
              {section.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-aqua/90"></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>

    <div class="card rounded-2xl p-5 sm:p-6">
      <h3 class="font-display text-xl text-ice">{content.contactCard.title}</h3>
      <p class="mt-3 text-sm leading-relaxed text-mist sm:text-[15px]">{content.contactCard.description}</p>
    </div>
  </Container>
</section>

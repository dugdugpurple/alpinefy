---
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';
import type { LegalPageContent } from '../../i18n/legal';

const { content } = Astro.props as { content: LegalPageContent };
---

<section class="pb-20 pt-32 sm:pb-24 sm:pt-36">
  <Container class="space-y-10">
    <SectionHeading
      eyebrow={content.heading.eyebrow}
      title={content.heading.title}
      subtitle={content.heading.subtitle}
    />

    <div class="inline-flex items-center gap-3 rounded-full border border-white/12 bg-coal/60 px-4 py-2">
      <span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>
      <span class="text-[11px] font-semibold uppercase tracking-[0.24em] text-mist">{content.lastUpdatedLabel}</span>
      <span class="text-sm font-medium text-ice">{content.lastUpdatedDate}</span>
    </div>

    <div class="grid gap-5 sm:gap-6">
      {content.sections.map((section) => (
        <article class="card">
          <h3 class="font-display text-xl font-bold leading-snug tracking-[-0.02em] text-ice sm:text-2xl">{section.title}</h3>
          <div class="mt-4 space-y-3 text-sm leading-[1.75] text-mist sm:text-[15px]">
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
          {section.bullets && section.bullets.length > 0 && (
            <ul class="mt-5 grid gap-2.5 text-sm leading-relaxed text-mist sm:text-[15px]">
              {section.bullets.map((bullet) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-gradient-to-br from-aqua to-lime"></span>
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
          )}
        </article>
      ))}
    </div>

    <div class="card">
      <h3 class="font-display text-xl font-bold leading-snug tracking-[-0.02em] text-ice">{content.contactCard.title}</h3>
      <p class="mt-3 text-sm leading-[1.75] text-mist sm:text-[15px]">{content.contactCard.description}</p>
    </div>
  </Container>
</section>

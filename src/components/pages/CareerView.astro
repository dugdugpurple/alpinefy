        <p class="text-base text-mist sm:text-lg">{copy.subtitle}</p>
      </div>

      <article class="card career-position-card max-w-6xl rounded-3xl p-6 sm:p-7">
        <div class="career-retro-overlay" aria-hidden="true"></div>
        <div class="career-position-content space-y-6">
          <div class="career-retro-window">
            <span class="career-retro-dot career-retro-dot-red"></span>
            <span class="career-retro-dot career-retro-dot-yellow"></span>
            <span class="career-retro-dot career-retro-dot-green"></span>
            <span class="career-retro-window-label">{copy.retroWindowLabel}</span>
            <span class="career-retro-status">{copy.retroStatus}</span>
          </div>

          <div class="flex flex-wrap items-center justify-between gap-3">
            <span class="career-role-badge">{copy.roleBadge}</span>
            <div class="flex flex-wrap items-center gap-2">
              {copy.roleMeta.map((item, index) => (
                <span class="tag career-meta-tag" style={`animation-delay:${index * 110}ms`}>{item}</span>
              ))}
            </div>
          </div>

          <div class="career-retro-fun-row">
            <div class="career-retro-counter">
              <p class="career-retro-counter-label">{copy.retroCounterLabel}</p>
              <p class="career-retro-counter-value" data-career-counter>{copy.retroCounterValue}</p>
            </div>
            <div class="career-retro-marquee">
              <div class="career-retro-marquee-track">
                <span>{copy.retroTicker}</span>
                <span aria-hidden="true">{copy.retroTicker}</span>
              </div>
            </div>
          </div>

          <div class="space-y-3">
            <h2 class="font-display text-2xl sm:text-3xl">{copy.roleTitle}</h2>
            <p class="text-sm text-mist sm:text-base">{copy.roleSummary}</p>
          </div>

          <div class="grid gap-4 md:grid-cols-2">
            <div class="career-block career-reveal" style="animation-delay: 40ms">
              <p class="career-block-title">{copy.sections.impact}</p>
              <ul class="space-y-2">
                {copy.impactItems.map((item, index) => (

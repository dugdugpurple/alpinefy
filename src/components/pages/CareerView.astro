                ))}
              </ul>
            </div>

            <div class="career-block career-reveal" style="animation-delay: 200ms">
              <p class="career-block-title">{copy.sections.stack}</p>
              <ul class="space-y-2">
                {copy.stackItems.map((item, index) => (
                  <li class="career-list-item" style={`animation-delay:${220 + index * 80}ms`}>{item}</li>
                ))}
              </ul>
            </div>


  <script is:inline>
    const initCareerCounter = () => {
      const counter = document.querySelector('[data-career-counter]');
      if (!counter || counter.dataset.ready === 'true') return;
      counter.dataset.ready = 'true';

      const sessionKey = 'alpinefy_career_counter_seen_v1';
      const localCounterKey = 'alpinefy_career_counter_local_v1';
      const prodCacheKey = 'alpinefy_career_counter_cached_v1';
      const counterEndpoint = '/.netlify/functions/career-counter';
      const fallbackValue = counter.textContent?.trim() || '001337';

      const formatCounter = (value) => {
        const number = Number.parseInt(String(value ?? ''), 10);
        if (!Number.isFinite(number) || number < 0) return fallbackValue;
        if (number > 999999) return String(number);
        return String(number).padStart(6, '0');
      };

      const writeCounter = (value) => {
        counter.textContent = formatCounter(value);
      };

      const hostname = window.location.hostname;
      const isLocalEnvironment =
        hostname === 'localhost' ||
        hostname === '127.0.0.1' ||
        hostname === '0.0.0.0' ||
        hostname === '::1' ||
        hostname.endsWith('.local');
      const fallbackBase = Number.parseInt(fallbackValue, 10) || 1337;

      const readLocalAbsolute = () => {
        const value = Number.parseInt(localStorage.getItem(localCounterKey) || '', 10);
        if (!Number.isFinite(value) || value < 0) return null;
        return value;
      };

      const writeLocalAbsolute = (value) => {
        localStorage.setItem(localCounterKey, String(value));
      };

      const incrementLocalFallback = () => {
        const current = readLocalAbsolute();
        const next = (current ?? fallbackBase) + 1;
        writeLocalAbsolute(next);
        return next;
      };

      const readCounter = async (shouldIncrement) => {
        const action = shouldIncrement ? 'hit' : 'get';
        const endpoint = `${counterEndpoint}?action=${action}`;
        const response = await fetch(endpoint, { method: 'GET', mode: 'cors', cache: 'no-store' });
        if (!response.ok) throw new Error(`Counter request failed: ${response.status}`);
        const payload = await response.json();
        if (typeof payload?.value !== 'number') throw new Error('Invalid counter payload');
        return payload.value;
      };

      const loadCounter = async () => {
        if (isLocalEnvironment) {
          const alreadyCounted = sessionStorage.getItem(sessionKey) === '1';
          const value = alreadyCounted ? (readLocalAbsolute() ?? fallbackBase) : incrementLocalFallback();
          if (!alreadyCounted) sessionStorage.setItem(sessionKey, '1');
          writeCounter(value);
          return;
        }

        try {
          const alreadyCounted = sessionStorage.getItem(sessionKey) === '1';
          if (alreadyCounted) {
            const cached = Number.parseInt(localStorage.getItem(prodCacheKey) || '', 10);
            if (Number.isFinite(cached) && cached >= 0) {
              writeCounter(cached);
              return;
            }
          }

          const value = await readCounter(true);
          sessionStorage.setItem(sessionKey, '1');
          localStorage.setItem(prodCacheKey, String(value));
          writeCounter(value);
        } catch {
          const cached = Number.parseInt(localStorage.getItem(prodCacheKey) || '', 10);
          if (Number.isFinite(cached) && cached >= 0) {
            writeCounter(cached);
            return;
          }
          writeCounter(fallbackValue);
        }
      };

      loadCounter();
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initCareerCounter);
    } else {
      initCareerCounter();
    }

    document.addEventListener('astro:page-load', initCareerCounter);
  </script>
</BaseLayout>

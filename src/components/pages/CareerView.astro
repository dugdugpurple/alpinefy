const copy = copyByLang[lang] ?? copyByLang.en;
const canonicalCareerPath = getRoutePath('career', lang);
const jobPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'JobPosting',
  title: copy.roleTitle,
  description: [copy.roleSummary, ...copy.impactItems, ...copy.mustHaveItems, ...copy.stackItems, ...copy.benefitsItems]
    .map((item) => `<p>${item}</p>`)
    .join(''),
  datePosted: '2026-03-31',
  employmentType: 'FULL_TIME',
  hiringOrganization: {
    '@type': 'Organization',
    name: site.name,
    sameAs: site.url,
    logo: `${site.url}/og-image-en.png`,
  },
  jobLocationType: 'TELECOMMUTE',
  applicantLocationRequirements: [
    { '@type': 'Country', name: 'Slovakia' },
    { '@type': 'Country', name: 'Czech Republic' },
    { '@type': 'Country', name: 'Poland' },
    { '@type': 'Country', name: 'Germany' },
  ],
  url: `${site.url}${canonicalCareerPath}`,
  directApply: true,
};
---

<BaseLayout lang={lang} title={copy.metaTitle} description={copy.metaDescription} structuredData={jobPostingSchema}>
  <section class="pb-20 pt-32 sm:pb-24 sm:pt-36">
    <Container class="space-y-10">

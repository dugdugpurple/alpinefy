            <a class="btn-primary" href={getRoutePath('careerInquiry', lang)}>{copy.ctaPrimary}</a>
            <a class="btn-secondary" href={getRoutePath('services', lang)}>{copy.ctaSecondary}</a>
          </div>
          <p class="text-sm text-mist">
            {copy.emailHint}{' '}

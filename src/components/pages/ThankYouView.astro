---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Container from '../../components/Container.astro';
import { site } from '../../data/site';
import { defaultLang, languages } from '../../i18n/languages';
import { getRoutePath } from '../../i18n/routes';

const { lang = defaultLang } = Astro.props;

const copyByLang = {
  en: {
    metaTitle: 'Thank You',
    metaDescription: 'Your message has been sent successfully.',
    eyebrow: 'Thank you',
    title: 'Thanks, we received your message.',
    bodyPrefix: 'We will get back shortly. If urgent, email',
    primaryLabel: 'Back to home',
    secondaryLabel: 'Back to contact',
  },
  de: {
    metaTitle: 'Danke',
    metaDescription: 'Ihre Nachricht wurde erfolgreich gesendet.',
    eyebrow: 'Danke',
    title: 'Danke, wir haben Ihre Nachricht erhalten.',
    bodyPrefix: 'Wir melden uns so schnell wie möglich. Wenn es dringend ist, schreiben Sie an',
    primaryLabel: 'Zur Startseite',
    secondaryLabel: 'Zurück zum Kontakt',
  },
  pl: {
    metaTitle: 'Dziękujemy',
    metaDescription: 'Twoja wiadomość została pomyślnie wysłana.',
    eyebrow: 'Dziękujemy',
    title: 'Dziękujemy, otrzymaliśmy Twoją wiadomość.',
    bodyPrefix: 'Odezwiemy się najszybciej jak to możliwe. Jeśli sprawa jest pilna, napisz na',
    primaryLabel: 'Powrót na stronę główną',
    secondaryLabel: 'Powrót do kontaktu',
  },
  cz: {
    metaTitle: 'Děkujeme',
    metaDescription: 'Vaše zpráva byla úspěšně odeslána.',
    eyebrow: 'Děkujeme',
    title: 'Děkujeme, zprávu jsme přijali.',
    bodyPrefix: 'Ozveme se co nejdříve. Pokud je to urgentní, napište na',
    primaryLabel: 'Zpět na web',
    secondaryLabel: 'Zpět na kontakt',
  },
  sk: {
    metaTitle: 'Ďakujeme',
    metaDescription: 'Vaša správa bola úspešne odoslaná.',
    eyebrow: 'Ďakujeme',
    title: 'Ďakujeme, správu sme prijali.',
    bodyPrefix: 'Ozveme sa čo najskôr. Ak je to urgentné, napíšte na',
    primaryLabel: 'Späť na web',
    secondaryLabel: 'Späť na kontakt',
  },
};

const copy = copyByLang[lang] ?? copyByLang.en;
const thankYouPathsByLang = Object.fromEntries(
  languages.map((item) => [item.code, getRoutePath('thankYou', item.code)])
);
---

<BaseLayout
  lang={lang}
  title={copy.metaTitle}
  description={copy.metaDescription}
  noindex={true}
>
  <section class="py-28 sm:py-32">
    <Container>
      <div class="card thank-you-card mx-auto flex max-w-2xl flex-col items-center text-center sm:p-10">
        <span class="inline-flex h-14 w-14 items-center justify-center rounded-2xl border border-aqua/25 bg-aqua/10 text-aqua shadow-[0_10px_30px_-12px_rgba(38,202,255,0.7)]">
          <svg viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2.2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12.5l4.5 4.5 10.5-11"></path>
          </svg>
        </span>
        <div class="mt-6 flex items-center gap-2.5">
          <span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>
          <p class="text-[11px] font-semibold uppercase tracking-[0.32em] text-mist">{copy.eyebrow}</p>
        </div>
        <h1 class="mt-4 font-display text-3xl font-bold leading-tight tracking-[-0.03em] text-ice sm:text-4xl">{copy.title}</h1>
        <p class="mt-4 max-w-lg text-sm leading-relaxed text-mist sm:text-base">
          {copy.bodyPrefix}{' '}
          <a class="font-medium text-aqua transition hover:text-ice" href={`mailto:${site.email}`}>{site.email}</a>.
        </p>
        <div class="mt-8 flex flex-wrap justify-center gap-3">
          <a class="btn-primary" href={getRoutePath('home', lang)}>{copy.primaryLabel}</a>
          <a class="btn-secondary" href={getRoutePath('contact', lang)}>{copy.secondaryLabel}</a>
        </div>
      </div>
    </Container>
  </section>

  <script is:inline define:vars={{ thankYouPathsByLang }}>
    (() => {
      const THANK_YOU_PATHS = thankYouPathsByLang;
      const SUPPORTED = Object.keys(THANK_YOU_PATHS);
      const normalizePath = (pathname) => {
        if (!pathname) return '/';
        const clean = pathname.split('?')[0].split('#')[0] || '/';
        if (clean === '/') return '/';
        const withLeading = clean.startsWith('/') ? clean : `/${clean}`;
        return withLeading.endsWith('/') ? withLeading.slice(0, -1) : withLeading;
      };
      const inferLangFromPath = (pathname) => {
        const normalized = normalizePath(pathname);
        const firstSegment = normalized.split('/').filter(Boolean)[0] || '';
        return SUPPORTED.includes(firstSegment) ? firstSegment : 'en';
      };
      const buildUrl = (path, params) => {
        const query = params.toString();
        return query ? `${path}?${query}` : path;
      };

      const params = new URLSearchParams(window.location.search);
      const source = params.get('src');
      const forcedLangParam = params.get('lang');
      const forcedLang = SUPPORTED.includes(forcedLangParam) ? forcedLangParam : null;
      const currentPath = normalizePath(window.location.pathname);
      const currentLang = inferLangFromPath(currentPath);

      let desiredLang = forcedLang ?? currentLang;

      if (!forcedLang && currentLang === 'en' && document.referrer) {
        try {
          const ref = new URL(document.referrer);
          if (ref.origin === window.location.origin) {
            const refLang = inferLangFromPath(ref.pathname);
            if (refLang !== 'en') desiredLang = refLang;
          }
        } catch {
          // no-op
        }
      }

      const desiredPath = normalizePath(THANK_YOU_PATHS[desiredLang] || THANK_YOU_PATHS.en);
      if (currentPath !== desiredPath) {
        params.set('lang', desiredLang);
        window.location.replace(buildUrl(desiredPath, params));
        return;
      }

      const htmlLang = (document.documentElement.lang || 'en').slice(0, 2).toLowerCase();
      const langFixKey = `thankyou-langfix:${desiredLang}:${desiredPath}`;
      if (htmlLang !== desiredLang) {
        if (sessionStorage.getItem(langFixKey) !== '1') {
          sessionStorage.setItem(langFixKey, '1');
          window.location.replace(buildUrl(desiredPath, params));
          return;
        }
      } else {
        sessionStorage.removeItem(langFixKey);
      }

      if (!source) return;

      const eventNameMap = {
        contact: 'contact_form_success',
        service_interest: 'contact_form_success',
        career_interest: 'contact_form_success',
        newsletter: 'newsletter_signup_success',
      };

      const eventName = eventNameMap[source];
      if (!eventName) return;

      const dedupeKey = `lead-event:${eventName}:${source || 'unknown'}:${window.location.pathname}`;
      if (sessionStorage.getItem(dedupeKey) === '1') return;
      sessionStorage.setItem(dedupeKey, '1');

      window.dataLayer = window.dataLayer || [];
      window.dataLayer.push({
        event: eventName,
        lead_source: source,
        page_path: window.location.pathname,
        page_language: document.documentElement.lang || 'en',
      });
    })();
  </script>
</BaseLayout>

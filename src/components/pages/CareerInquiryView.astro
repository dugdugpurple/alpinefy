const copy = copyByLang[lang] ?? copyByLang.en;
const formName = 'career-interest';
const currentPath = Astro.url.pathname;
---

<BaseLayout lang={lang} title={copy.metaTitle} description={copy.metaDescription} noindex={true}>
  <section class="py-20 sm:py-24">
    <Container class="grid gap-8 lg:grid-cols-[0.95fr_1.05fr]">
      <article class="h-fit space-y-6 rounded-3xl border border-white/10 bg-coal/70 p-6 shadow-panel sm:p-7">
        <div class="flex items-center gap-2.5">
          <span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>
          <p class="text-[11px] font-semibold uppercase tracking-[0.32em] text-mist">{copy.eyebrow}</p>
        </div>
        <div class="space-y-4">
          <h1 class="font-display text-3xl font-bold leading-[1.05] tracking-[-0.035em] sm:text-4xl">{copy.title}</h1>
          <p class="text-sm text-mist sm:text-base">{copy.subtitle}</p>
        </div>

        <div class="rounded-2xl border border-white/10 bg-night/40 p-5">
          <div class="flex items-center gap-2.5">
            <span class="h-1.5 w-1.5 rounded-full bg-lime"></span>
            <p class="text-[11px] font-semibold uppercase tracking-[0.24em] text-mist">{copy.focusLabel}</p>
          </div>
          <ul class="mt-4 space-y-3 text-sm text-mist">
            {copy.focusPoints.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-[7px] inline-flex h-1.5 w-1.5 shrink-0 rounded-full bg-gradient-to-br from-aqua to-lime shadow-[0_0_10px_rgba(38,202,255,0.5)]"></span>
                <span class="leading-relaxed">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <a class="btn-secondary w-full sm:w-auto" href={getRoutePath('career', lang)}>{copy.backLabel}</a>
      </article>

      <article class="rounded-3xl border border-white/10 bg-coal/70 p-6 shadow-panel sm:p-8">
        <div class="flex items-center gap-2.5">
          <span class="h-1.5 w-1.5 rounded-full bg-aqua"></span>
          <p class="text-[11px] font-semibold uppercase tracking-[0.3em] text-mist">{copy.formTitle}</p>
        </div>
        <p class="mt-3 text-sm text-mist">{copy.formSubtitle}</p>

        <form
          class="mt-6 grid gap-4"
          name={formName}
          method="POST"
          enctype="multipart/form-data"
          netlify
          netlify-honeypot="bot-field"
          data-netlify="true"
          data-netlify-honeypot="bot-field"
          data-capture-attribution="true"
          action={`${getRoutePath('thankYou', lang)}?src=career_interest&lang=${lang}`}
        >
          <input type="hidden" name="form-name" value={formName} />
          <p class="hidden">
            <label>
              Don’t fill this out if you’re human: <input name="bot-field" />
            </label>
          </p>

          <input type="hidden" name="recipient" value={site.email} />
          <input type="hidden" name="subject" value={copy.subject} />
          <input type="hidden" name="locale" value={lang} />
          <input type="hidden" name="source_page" value={currentPath} />
          {attributionFieldNames.map((field) => (
            <input type="hidden" name={field} value="" data-attribution-field={field} />
          ))}

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="grid min-w-0 gap-2 text-sm text-mist">
              {copy.nameLabel}
              <input class="input-field w-full" name="name" placeholder={copy.namePlaceholder} required />
            </label>
            <label class="grid min-w-0 gap-2 text-sm text-mist">
              {copy.emailLabel}
              <input
                class="input-field w-full"
                name="email"
                type="email"
                placeholder={copy.emailPlaceholder}
                required
              />
            </label>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="grid min-w-0 gap-2 text-sm text-mist">
              {copy.phoneLabel}
              <input class="input-field w-full" name="phone" placeholder={copy.phonePlaceholder} required />
            </label>
            <label class="grid min-w-0 gap-2 text-sm text-mist">
              {copy.experienceLabel}
              <select class="input-field w-full" name="experience_level" required>
                <option value="" selected disabled>{copy.experiencePlaceholder}</option>
                {copy.experienceOptions.map((option) => (
                  <option value={option.value}>{option.label}</option>
                ))}
              </select>
            </label>
          </div>

          <div class="grid gap-4 sm:grid-cols-2">
            <label class="grid min-w-0 gap-2 text-sm text-mist">
              {copy.cvLabel}
              <input class="file-input w-full" name="cv_file" type="file" accept=".pdf,.doc,.docx" required />
            </label>
            <label class="grid min-w-0 gap-2 text-sm text-mist">
              {copy.motivationLabel}
              <input
                class="file-input w-full"
                name="motivation_file"
                type="file"
                accept=".pdf,.doc,.docx"
                required
              />
            </label>
          </div>

          <label class="grid min-w-0 gap-2 text-sm text-mist">
            {copy.extraLabel}
            <input class="file-input w-full" name="extra_attachment" type="file" accept=".pdf,.doc,.docx" />
          </label>

          <label class="grid min-w-0 gap-2 text-sm text-mist">
            {copy.messageLabel}
            <textarea
              class="input-field min-h-[130px] w-full"
              name="message"
              placeholder={copy.messagePlaceholder}
              required
            ></textarea>
          </label>

          <label class="flex items-start gap-3 text-xs text-mist">
            <input
              class="mt-0.5 h-4 w-4 shrink-0 rounded border border-white/25 bg-night/70 accent-[rgb(var(--color-aqua))]"
              name="consent"
              type="checkbox"
              value="yes"
              required
            />
            <span>{copy.consentLabel}</span>
          </label>

          <button class="btn-primary mt-2 w-full shadow-glow" type="submit">{copy.submitLabel}</button>
          <p class="text-xs text-mist">{copy.consentNote}</p>
        </form>
      </article>
    </Container>
  </section>
</BaseLayout>

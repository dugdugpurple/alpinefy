---
import { defaultLang, type Lang } from '../i18n/languages';

const { lang = defaultLang } = Astro.props as { lang?: Lang };

type CookieCopy = {
  title: string;
  description: string;
  details: string;
  necessary: string;
  necessaryDescription: string;
  analytics: string;
  analyticsDescription: string;
  acceptAll: string;
  rejectAll: string;
  saveSelection: string;
  reopen: string;
};

const cookieCopy: Record<Lang, CookieCopy> = {
  en: {
    title: 'Cookies and privacy settings',
    description:
      'We use essential cookies for website operation. Analytics cookies (GA4 and Clarity) are only enabled after your consent.',
    details: 'Customize settings',
    necessary: 'Necessary cookies',
    necessaryDescription: 'Always active. They keep the website functional and secure.',
    analytics: 'Analytics cookies',
    analyticsDescription: 'Help us measure traffic and improve pages based on real behavior.',
    acceptAll: 'Accept all',
    rejectAll: 'Reject analytics',
    saveSelection: 'Save selection',
    reopen: 'Cookie settings',
  },
  de: {
    title: 'Cookie- und Datenschutzeinstellungen',
    description:
      'Wir verwenden notwendige Cookies für den Betrieb der Website. Analyse-Cookies (GA4 und Clarity) aktivieren wir erst nach Ihrer Zustimmung.',
    details: 'Einstellungen anpassen',
    necessary: 'Notwendige Cookies',
    necessaryDescription: 'Immer aktiv. Sie sichern Funktion und Stabilität der Website.',
    analytics: 'Analyse-Cookies',
    analyticsDescription: 'Sie helfen uns, Traffic zu messen und Seiten datenbasiert zu verbessern.',
    acceptAll: 'Alle akzeptieren',
    rejectAll: 'Analyse ablehnen',
    saveSelection: 'Auswahl speichern',
    reopen: 'Cookie-Einstellungen',
  },
  pl: {
    title: 'Ustawienia cookies i prywatności',
    description:
      'Używamy niezbędnych cookies do działania strony. Cookies analityczne (GA4 i Clarity) włączamy dopiero po Twojej zgodzie.',
    details: 'Dostosuj ustawienia',
    necessary: 'Niezbędne cookies',
    necessaryDescription: 'Zawsze aktywne. Zapewniają poprawne i bezpieczne działanie strony.',
    analytics: 'Analityczne cookies',
    analyticsDescription: 'Pomagają mierzyć ruch i rozwijać stronę na podstawie danych.',
    acceptAll: 'Akceptuj wszystko',
    rejectAll: 'Odrzuć analitykę',
    saveSelection: 'Zapisz wybór',
    reopen: 'Ustawienia cookies',
  },
  cz: {
    title: 'Nastavení cookies a soukromí',
    description:
      'Používáme nezbytné cookies pro provoz webu. Analytické cookies (GA4 a Clarity) zapneme až po vašem souhlasu.',
    details: 'Upravit nastavení',
    necessary: 'Nezbytné cookies',
    necessaryDescription: 'Vždy aktivní. Zajišťují správné a bezpečné fungování webu.',
    analytics: 'Analytické cookies',
    analyticsDescription: 'Pomáhají měřit návštěvnost a zlepšovat web podle dat.',
    acceptAll: 'Přijmout vše',
    rejectAll: 'Odmítnout analytiku',
    saveSelection: 'Uložit výběr',
    reopen: 'Nastavení cookies',
  },
  sk: {
    title: 'Nastavenia cookies a súkromia',
    description:
      'Nevyhnutné cookies používame na fungovanie webu. Analytické cookies (GA4 a Clarity) zapíname až po vašom súhlase.',
    details: 'Upraviť nastavenia',
    necessary: 'Nevyhnutné cookies',
    necessaryDescription: 'Vždy aktívne. Zabezpečujú správne a bezpečné fungovanie webu.',
    analytics: 'Analytické cookies',
    analyticsDescription: 'Pomáhajú nám merať návštevnosť a zlepšovať web podľa dát.',
    acceptAll: 'Prijať všetko',
    rejectAll: 'Odmietnuť analytiku',
    saveSelection: 'Uložiť výber',
    reopen: 'Nastavenia cookies',
  },
};

const copy = cookieCopy[lang] ?? cookieCopy.en;
---

<button
  type="button"
  class="cookie-banner-dock-btn fixed bottom-4 left-1/2 z-[115] hidden -translate-x-1/2 rounded-full border border-white/20 bg-coal/85 px-4 py-2 text-xs font-semibold text-ice shadow-panel backdrop-blur transition hover:border-aqua/40 hover:text-aqua"
  data-cookie-open
>
  {copy.reopen}
</button>

<section
  class="cookie-banner-root fixed inset-x-0 bottom-0 z-[120] hidden p-4 sm:p-6"
  data-cookie-root
  data-lang={lang}
  data-state="hidden"
  aria-hidden="true"
>
  <div
    class="cookie-banner-panel mx-auto w-full max-w-4xl rounded-3xl border border-white/18 bg-coal/94 p-5 shadow-panel backdrop-blur lg:p-6"
    data-cookie-panel
  >
    <p class="text-base font-semibold text-ice sm:text-lg">{copy.title}</p>
    <p class="mt-2 max-w-3xl text-sm text-mist">{copy.description}</p>

    <button
      type="button"
      class="mt-4 inline-flex items-center gap-2 rounded-full border border-aqua/35 bg-aqua/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.12em] text-aqua transition hover:border-aqua/55"
      data-cookie-details-toggle
      aria-expanded="false"
    >
      {copy.details}
    </button>

    <div class="mt-4 hidden space-y-3" data-cookie-details>
      <div class="rounded-2xl border border-white/12 bg-white/5 p-3">
        <label class="flex cursor-not-allowed items-start justify-between gap-4">
          <span>
            <span class="block text-sm font-medium text-ice">{copy.necessary}</span>
            <span class="mt-1 block text-xs text-mist">{copy.necessaryDescription}</span>
          </span>
          <input class="mt-1 h-4 w-4 accent-aqua" type="checkbox" checked disabled />
        </label>
      </div>
      <div class="rounded-2xl border border-white/12 bg-white/5 p-3">
        <label class="flex items-start justify-between gap-4">
          <span>
            <span class="block text-sm font-medium text-ice">{copy.analytics}</span>
            <span class="mt-1 block text-xs text-mist">{copy.analyticsDescription}</span>
          </span>
          <input class="mt-1 h-4 w-4 accent-aqua" type="checkbox" data-cookie-analytics />
        </label>
      </div>
    </div>

    <div class="mt-5 flex flex-wrap items-center gap-2 sm:gap-3">
      <button
        type="button"
        class="inline-flex min-h-10 items-center justify-center rounded-full border border-white/18 bg-white/6 px-4 text-sm font-medium text-ice/90 transition hover:border-white/35 hover:text-ice"
        data-cookie-reject
      >
        {copy.rejectAll}
      </button>
      <button type="button" class="btn-primary min-h-10 px-5 text-sm" data-cookie-accept>
        {copy.acceptAll}
      </button>
      <button
        type="button"
        class="hidden min-h-10 rounded-full border border-aqua/45 bg-aqua/12 px-5 text-sm font-semibold text-aqua transition hover:border-aqua/65"
        data-cookie-save
      >
        {copy.saveSelection}
      </button>
    </div>
  </div>
</section>

<script is:inline>
  const initCookieBanner = () => {
    const root = document.querySelector('[data-cookie-root]');
    if (!root || root.dataset.ready === 'true') return;
    root.dataset.ready = 'true';

    const STORAGE_KEY = 'alpinefy_cookie_consent_v1';
    const CONSENT_EVENT = 'alpinefy:consent:update';

    const openButton = document.querySelector('[data-cookie-open]');
    const detailsButton = root.querySelector('[data-cookie-details-toggle]');
    const detailsPanel = root.querySelector('[data-cookie-details]');
    const analyticsInput = root.querySelector('[data-cookie-analytics]');
    const acceptButton = root.querySelector('[data-cookie-accept]');
    const rejectButton = root.querySelector('[data-cookie-reject]');
    const saveButton = root.querySelector('[data-cookie-save]');
    const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ANIM_MS = {
      assemble: 760,
      open: 560,
      close: 520,
    };
    let bannerStateToken = 0;

    const setBannerOpen = (open, mode = 'standard') => {
      bannerStateToken += 1;
      const token = bannerStateToken;
      if (open) {
        root.classList.remove('hidden');
        root.setAttribute('aria-hidden', 'false');
        root.dataset.state = mode === 'assemble' ? 'assembling' : 'opening';

        if (prefersReducedMotion) {
          root.dataset.state = 'open';
          return;
        }

        window.setTimeout(
          () => {
            if (bannerStateToken !== token) return;
            root.dataset.state = 'open';
          },
          mode === 'assemble' ? ANIM_MS.assemble : ANIM_MS.open
        );
        return;
      }

      if (root.classList.contains('hidden')) return;
      root.setAttribute('aria-hidden', 'true');
      root.dataset.state = 'closing';

      if (prefersReducedMotion) {
        root.classList.add('hidden');
        root.dataset.state = 'hidden';
        return;
      }

      window.setTimeout(() => {
        if (bannerStateToken !== token) return;
        root.classList.add('hidden');
        root.dataset.state = 'hidden';
      }, ANIM_MS.close);
    };

    const setDetailsOpen = (open) => {
      detailsPanel?.classList.toggle('hidden', !open);
      detailsButton?.setAttribute('aria-expanded', open ? 'true' : 'false');
      saveButton?.classList.toggle('hidden', !open);
    };

    const showOpenButton = () => {
      openButton?.classList.remove('hidden');
      openButton?.setAttribute('data-state', 'visible');
    };

    const hideOpenButton = () => {
      openButton?.classList.add('hidden');
      openButton?.setAttribute('data-state', 'hidden');
    };

    const readStoredConsent = () => {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw);
        return typeof parsed?.analytics === 'boolean' ? parsed : null;
      } catch {
        return null;
      }
    };

    const persistAndEmit = (analyticsGranted, source) => {
      const payload = {
        version: 1,
        analytics: analyticsGranted,
        source,
        updatedAt: new Date().toISOString(),
      };

      localStorage.setItem(STORAGE_KEY, JSON.stringify(payload));
      document.dispatchEvent(
        new CustomEvent(CONSENT_EVENT, {
          detail: { analytics: analyticsGranted, source },
        })
      );
      return payload;
    };

    const clearAnalyticsCookies = () => {
      const cookieNames = document.cookie
        .split(';')
        .map((entry) => entry.trim().split('=')[0])
        .filter(Boolean);

      const domains = [location.hostname, `.${location.hostname}`];
      const clearCookie = (name) => {
        document.cookie = `${name}=; Max-Age=0; path=/; SameSite=Lax`;
        domains.forEach((domain) => {
          document.cookie = `${name}=; Max-Age=0; path=/; domain=${domain}; SameSite=Lax`;
        });
      };

      cookieNames.forEach((name) => {
        if (
          name.startsWith('_ga') ||
          name.startsWith('_gid') ||
          name.startsWith('_gat') ||
          name.startsWith('_gcl') ||
          name.startsWith('_clck') ||
          name.startsWith('_clsk')
        ) {
          clearCookie(name);
        }
      });
    };

    const applyConsent = (analyticsGranted, source) => {
      const previous = readStoredConsent();
      if (analyticsInput) analyticsInput.checked = analyticsGranted;
      if (!analyticsGranted) clearAnalyticsCookies();
      persistAndEmit(analyticsGranted, source);
      setDetailsOpen(false);
      hideOpenButton();
      setBannerOpen(false, 'dock');
      window.setTimeout(() => {
        showOpenButton();
      }, prefersReducedMotion ? 0 : ANIM_MS.close);

      if (previous?.analytics === true && analyticsGranted === false) {
        window.setTimeout(() => {
          window.location.reload();
        }, prefersReducedMotion ? 120 : ANIM_MS.close + 100);
      }
    };

    const stored = readStoredConsent();

    if (stored) {
      if (analyticsInput) analyticsInput.checked = stored.analytics;
      setBannerOpen(false, 'dock');
      setDetailsOpen(false);
      showOpenButton();
    } else {
      hideOpenButton();
      setBannerOpen(true, 'assemble');
      setDetailsOpen(false);
    }

    detailsButton?.addEventListener('click', () => {
      const isOpen = detailsButton.getAttribute('aria-expanded') === 'true';
      setDetailsOpen(!isOpen);
    });

    openButton?.addEventListener('click', () => {
      const current = readStoredConsent();
      if (analyticsInput && current) analyticsInput.checked = current.analytics;
      setBannerOpen(true, 'dock');
      setDetailsOpen(true);
      hideOpenButton();
    });

    acceptButton?.addEventListener('click', () => {
      applyConsent(true, 'accept_all');
    });

    rejectButton?.addEventListener('click', () => {
      applyConsent(false, 'reject_analytics');
    });

    saveButton?.addEventListener('click', () => {
      applyConsent(Boolean(analyticsInput?.checked), 'custom_selection');
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initCookieBanner);
  } else {
    initCookieBanner();
  }

  document.addEventListener('astro:page-load', initCookieBanner);
</script>

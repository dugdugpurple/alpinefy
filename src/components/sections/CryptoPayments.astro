---
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';
import { siBitcoin, siEthereum, siTether, siSolana } from 'simple-icons';

const { lang = defaultLang } = Astro.props;
const { sections } = getCopy(lang);

const coins = [
  { name: 'BTC', fullName: 'Bitcoin', icon: siBitcoin },
  { name: 'ETH', fullName: 'Ethereum', icon: siEthereum },
  { name: 'USDT', fullName: 'Tether', icon: siTether },
  { name: 'SOL', fullName: 'Solana', icon: siSolana },
];
---

<section class="relative overflow-hidden py-16 sm:py-20">
  <div class="crypto-grid-overlay absolute inset-0 -z-10 opacity-70" aria-hidden="true"></div>

  <Container class="relative">
    <div class="grid items-start gap-8 lg:grid-cols-[1fr_1fr] lg:gap-10">
      <div class="space-y-5">
        <SectionHeading
          eyebrow={sections.crypto.eyebrow}
          title={sections.crypto.title}
          subtitle={sections.crypto.subtitle}
        />
        <p class="rounded-2xl border border-white/12 bg-coal/60 px-4 py-3 text-xs text-mist sm:text-sm">
          {sections.crypto.note}
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2">
        {coins.map((coin) => (
          <article class="payment-coin card-3d" style={`--brand:#${coin.icon.hex}`}>
            <div class="inline-flex h-12 w-12 items-center justify-center rounded-2xl border border-white/10 bg-white/10 text-[var(--brand)]">
              <svg viewBox="0 0 24 24" class="h-6 w-6" fill="currentColor" aria-hidden="true">
                <path d={coin.icon.path}></path>
              </svg>
            </div>
            <div>
              <p class="text-xs font-semibold uppercase tracking-[0.24em] text-mist">{coin.name}</p>
              <p class="mt-1 text-sm text-ice/92">{coin.fullName}</p>
            </div>
          </article>
        ))}
      </div>
    </div>
  </Container>
</section>

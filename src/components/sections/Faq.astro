---
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';

const { lang = defaultLang } = Astro.props;
const { sections } = getCopy(lang);
const faqLeftColumn = sections.faq.items.filter((_, index) => index % 2 === 0);
const faqRightColumn = sections.faq.items.filter((_, index) => index % 2 === 1);
---

<section class="py-20 sm:py-24" id="faq">
  <Container class="space-y-12">
    <SectionHeading
      eyebrow={sections.faq.eyebrow}
      title={sections.faq.title}
      subtitle={sections.faq.subtitle}
    />
    <div class="md:hidden">
      {sections.faq.items.map((item) => (
        <details class="group border-t border-white/10 py-5 last:border-b">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-5 text-base font-semibold text-ice transition-colors duration-200 group-hover:text-ice">
            <span>{item.question}</span>
            <span
              class="faq-toggle-icon inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/12 text-aqua transition duration-300 group-hover:border-aqua/40 group-open:border-aqua/45 group-open:bg-aqua/10"
              aria-hidden="true"
            >
              <svg
                viewBox="0 0 20 20"
                class="h-3.5 w-3.5 transition-transform duration-200 ease-out group-open:rotate-45"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
              >
                <path stroke-linecap="round" d="M10 4v12"></path>
                <path stroke-linecap="round" d="M4 10h12"></path>
              </svg>
            </span>
          </summary>
          <p class="mt-4 max-w-prose text-sm leading-relaxed text-mist">{item.answer}</p>
        </details>
      ))}
    </div>

    <div class="hidden items-start gap-x-12 md:grid md:grid-cols-2">
      <div>
        {faqLeftColumn.map((item) => (
          <details class="group border-t border-white/10 py-5 last:border-b">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 text-base font-semibold text-ice">
              <span>{item.question}</span>
              <span
                class="faq-toggle-icon inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/12 text-aqua transition duration-300 group-hover:border-aqua/40 group-open:border-aqua/45 group-open:bg-aqua/10"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 20 20"
                  class="h-3.5 w-3.5 transition-transform duration-200 ease-out group-open:rotate-45"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" d="M10 4v12"></path>
                  <path stroke-linecap="round" d="M4 10h12"></path>
                </svg>
              </span>
            </summary>
            <p class="mt-4 max-w-prose text-sm leading-relaxed text-mist">{item.answer}</p>
          </details>
        ))}
      </div>

      <div>
        {faqRightColumn.map((item) => (
          <details class="group border-t border-white/10 py-5 last:border-b">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-5 text-base font-semibold text-ice">
              <span>{item.question}</span>
              <span
                class="faq-toggle-icon inline-flex h-8 w-8 shrink-0 items-center justify-center rounded-full border border-white/12 text-aqua transition duration-300 group-hover:border-aqua/40 group-open:border-aqua/45 group-open:bg-aqua/10"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 20 20"
                  class="h-3.5 w-3.5 transition-transform duration-200 ease-out group-open:rotate-45"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                >
                  <path stroke-linecap="round" d="M10 4v12"></path>
                  <path stroke-linecap="round" d="M4 10h12"></path>
                </svg>
              </span>
            </summary>
            <p class="mt-4 max-w-prose text-sm leading-relaxed text-mist">{item.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </Container>
</section>

---
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';

const { lang = defaultLang } = Astro.props;
const { sections } = getCopy(lang);
---

<section class="py-20 sm:py-24" id="faq">
  <Container class="space-y-12">
    <SectionHeading
      eyebrow={sections.faq.eyebrow}
      title={sections.faq.title}
      subtitle={sections.faq.subtitle}
    />
    <div class="grid gap-4 md:grid-cols-2">
      {sections.faq.items.map((item) => (
        <details class="card group rounded-2xl p-5">
          <summary class="cursor-pointer list-none text-base font-semibold text-ice">
            <span class="flex items-center justify-between gap-5">
              {item.question}
              <span class="inline-flex h-7 w-7 items-center justify-center rounded-full border border-white/15 text-aqua transition group-open:rotate-45">
                +
              </span>
            </span>
          </summary>
          <p class="mt-4 text-sm text-mist">{item.answer}</p>
        </details>
      ))}
    </div>
  </Container>
</section>

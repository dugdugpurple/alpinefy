---
const {
  eyebrow,
  title,
  subtitle,
  align = 'left',
  class: className = '',
} = Astro.props;
const isCenter = align === 'center';
---

<div class={`flex flex-col gap-5 ${isCenter ? 'items-center text-center mx-auto max-w-3xl' : 'items-start text-left max-w-3xl'} ${className}`}>
  {eyebrow && (
    <span class="inline-flex items-center gap-2.5 text-[11px] font-semibold uppercase tracking-[0.32em] text-mist">
      <span class="h-1.5 w-1.5 rounded-full bg-aqua shadow-[0_0_12px_2px_rgba(38,202,255,0.7)]"></span>
      {eyebrow}
    </span>
  )}
  {title && (
    <h2 class="font-display text-4xl font-bold leading-[0.98] tracking-[-0.04em] text-ice sm:text-5xl lg:text-6xl">
      {title}
    </h2>
  )}
  {subtitle && (
    <p class="max-w-2xl text-base leading-relaxed text-mist sm:text-lg">{subtitle}</p>
  )}
</div>

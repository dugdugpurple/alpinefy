---
import Container from '../Container.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';

const { lang = defaultLang } = Astro.props;
const { sections } = getCopy(lang);
const checkPath = 'M5 13l4 4L19 7';
---

<section class="pb-12 sm:pb-16">
  <Container>
    <div class="grid gap-px overflow-hidden rounded-3xl border border-white/8 bg-white/[0.06] sm:grid-cols-2 lg:grid-cols-4">
      {sections.trustBadges.items.map((badge) => (
        <div class="group flex flex-col gap-3.5 bg-night/70 p-6 transition duration-300 hover:bg-white/[0.02] sm:p-7">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex h-6 w-6 items-center justify-center rounded-full border border-aqua/30 bg-aqua/10 text-aqua transition duration-300 group-hover:border-aqua/50">
              <svg viewBox="0 0 24 24" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="2.4">
                <path stroke-linecap="round" stroke-linejoin="round" d={checkPath}></path>
              </svg>
            </span>
            <span class="text-[10px] font-semibold uppercase tracking-[0.28em] text-mist/90">Verified</span>
          </div>
          <div>
            <p class="font-display text-base font-semibold text-ice">{badge.title}</p>
            <p class="mt-1.5 text-sm leading-relaxed text-mist">{badge.description}</p>
          </div>
        </div>
      ))}
    </div>
  </Container>
</section>

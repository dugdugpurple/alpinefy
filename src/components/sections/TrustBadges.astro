---
import Container from '../Container.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';

const { lang = defaultLang } = Astro.props;
const { sections } = getCopy(lang);
const labelPath =
  'M12 3l7 4v5c0 5-3.5 8-7 9-3.5-1-7-4-7-9V7l7-4z';
const checkPath = 'M9 12l2 2 4-4';
---

<section class="pb-10 sm:pb-12">
  <Container>
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {sections.trustBadges.items.map((badge) => (
        <div class="card rounded-2xl p-5">
          <div class="flex items-center gap-2 text-aqua/90">
            <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={labelPath}></path>
              <path stroke-linecap="round" stroke-linejoin="round" d={checkPath}></path>
            </svg>
            <p class="text-xs font-semibold uppercase tracking-[0.28em]">Verified</p>
          </div>
          <p class="mt-3 font-display text-lg font-semibold">{badge.title}</p>
          <p class="mt-2 text-sm text-mist">{badge.description}</p>
        </div>
      ))}
    </div>
  </Container>
</section>

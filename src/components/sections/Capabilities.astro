---
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';
import SectionMarks from '../SectionMarks.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';

const { lang = defaultLang } = Astro.props;
const { sections } = getCopy(lang);
---

<section class="relative py-16 sm:py-20">
  <SectionMarks variant="big-a" />
  <Container class="space-y-12">
    <SectionHeading
      eyebrow={sections.capabilities.eyebrow}
      title={sections.capabilities.title}
      subtitle={sections.capabilities.subtitle}
    />
    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {sections.capabilities.items.map((item) => (
        <div class="group flex min-h-[3.25rem] items-center gap-3 rounded-2xl border border-white/8 bg-white/[0.03] px-4 py-3 transition duration-300 hover:border-aqua/30 hover:bg-white/[0.05]">
          <span class="inline-flex h-6 w-6 shrink-0 items-center justify-center rounded-full border border-aqua/25 bg-aqua/10 text-aqua">
            <svg viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="currentColor" aria-hidden="true">
              <path d="M7.5 13.5 4.5 10.5 3 12l4.5 4.5L17 7.5 15.5 6l-8 7.5z"></path>
            </svg>
          </span>
          <span class="text-sm text-ice/90">{item}</span>
        </div>
      ))}
    </div>
  </Container>
</section>

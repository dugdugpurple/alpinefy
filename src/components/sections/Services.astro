---
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';
import { defaultLang, type Lang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';
import { getRoutePath } from '../../i18n/routes';
import {
  getServiceAnchor,
  getServiceFunnelCopy,
  getServiceInquiryPath,
  getServiceKeyByIndex,
} from '../../data/services-funnel';
import { siShopify, siClaude } from 'simple-icons';
import SectionMarks from '../SectionMarks.astro';

const { lang = defaultLang, mode = 'home' } = Astro.props as { lang?: Lang; mode?: 'home' | 'services' };
const { sections } = getCopy(lang);
const funnelCopy = getServiceFunnelCopy(lang);
const isServicesMode = mode === 'services';

// Per-service icon: line glyphs for the two generic services, brand marks (fill) for Shopify + Claude.
const serviceIcons = [
  // Lead websites — target / aim at conversions
  { fill: false, inner: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/>' },
  // Corporate websites — building
  { fill: false, inner: '<path d="M4 21V8l6-4 6 4v13"/><path d="M2 21h20"/><path d="M9 21v-5h2v5"/><path d="M8 9h.5M13 9h.5M8 12.5h.5M13 12.5h.5"/>' },
  // E-shops — Shopify brand mark
  { fill: true, inner: `<path d="${siShopify.path}"/>` },
  // Automation & AI — Claude brand mark
  { fill: true, inner: `<path d="${siClaude.path}"/>` },
];

---

<section class="relative py-20 sm:py-24" id="sluzby">
  <SectionMarks variant="c" />
  <Container class="space-y-12">
    <SectionHeading
      eyebrow={sections.services.eyebrow}
      title={sections.services.title}
      subtitle={sections.services.subtitle}
    />
    <div class="grid gap-5 md:grid-cols-2">
      {sections.services.items.map((service, index) => {
        const serviceKey = getServiceKeyByIndex(index);
        const anchor = getServiceAnchor(serviceKey);
        const highlights = funnelCopy.highlights[serviceKey] ?? [];
        const homeCtaHref = `${getRoutePath('services', lang)}#${anchor.id}`;
        const inquiryHref = getServiceInquiryPath(lang, serviceKey);
        return (
          <div class="relative">
            {anchor.aliases.map((alias) => (
              <span id={alias} class="pointer-events-none absolute -top-28 block h-0 w-0"></span>
            ))}
            <article id={anchor.id} class="card card-3d h-full scroll-mt-28" data-spotlight>
              <span class="card-mist" aria-hidden="true"></span>
              <div class="flex items-start gap-4">
                <span class="inline-flex h-11 w-11 shrink-0 items-center justify-center rounded-2xl border border-white/15 bg-white/8 text-aqua">
                  <svg
                    viewBox="0 0 24 24"
                    class="h-5 w-5"
                    fill={serviceIcons[index].fill ? 'currentColor' : 'none'}
                    stroke={serviceIcons[index].fill ? 'none' : 'currentColor'}
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={serviceIcons[index].inner}
                  ></svg>
                </span>
                <div>
                  <h3 class="font-display text-2xl">{service.title}</h3>
                  <p class="mt-3 text-sm text-mist">{service.description}</p>
                </div>
              </div>
              <div class="mt-5 flex flex-wrap gap-2">
                {service.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
              {isServicesMode && highlights.length > 0 && (
                <ul class="mt-5 space-y-2 text-sm text-mist">
                  {highlights.map((item) => (
                    <li class="flex items-start gap-2">
                      <span class="mt-1.5 inline-flex h-1.5 w-1.5 shrink-0 rounded-full bg-aqua/90"></span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
              <div class="mt-6">
                <a
                  class={isServicesMode ? 'btn-primary w-full sm:w-auto' : 'btn-secondary w-full sm:w-auto'}
                  href={isServicesMode ? inquiryHref : homeCtaHref}
                >
                  {isServicesMode ? funnelCopy.servicesCardCta : funnelCopy.homeCardCta}
                </a>
              </div>
            </article>
          </div>
        );
      })}
    </div>
  </Container>
</section>

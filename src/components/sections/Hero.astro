---
import Container from '../Container.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';
import {
  siGoogle,
  siStripe,
  siCloudflare,
  siVercel,
  siFigma,
  siGithub,
  siNotion,
  siGoogleanalytics,
  siGoogletagmanager,
} from 'simple-icons';

const {
  eyebrow,
  title,
  subtitle,
  primaryLabel,
  primaryHref,
  secondaryLabel,
  secondaryHref,
  stats = [],
  lang = defaultLang,
} = Astro.props;

const { sections } = getCopy(lang);
const heroSide = sections.heroSide;

const heroBrands = [
  { name: 'Google', icon: siGoogle },
  { name: 'Stripe', icon: siStripe },
  { name: 'Cloudflare', icon: siCloudflare },
  { name: 'Vercel', icon: siVercel },
  { name: 'Figma', icon: siFigma },
  { name: 'GitHub', icon: siGithub },
  { name: 'Notion', icon: siNotion },
  { name: 'GA4', icon: siGoogleanalytics },
  { name: 'GTM', icon: siGoogletagmanager },
];
const brandLoop = [...heroBrands, ...heroBrands];
const ecosystemLabel = {
  en: 'Core stack + analytics ecosystem',
  de: 'Core-Stack + Analytics-Ökosystem',
  pl: 'Główny stack + ekosystem analityki',
  cz: 'Hlavní stack + analytický ekosystém',
  sk: 'Hlavný stack + analytický ekosystém',
};
---

<section class="relative overflow-hidden px-0 pb-20 pt-32 sm:pb-24 sm:pt-36">
  <div class="hero-grid-overlay absolute inset-0 -z-20" aria-hidden="true"></div>
  <div class="hero-scan-layer absolute inset-0 -z-10" aria-hidden="true">
    <span class="hero-scan hero-scan-1"></span>
    <span class="hero-scan hero-scan-2"></span>
    <span class="hero-scan hero-scan-3"></span>
  </div>
  <div class="pointer-events-none absolute -top-24 left-4 -z-10 h-64 w-64 rounded-full bg-aqua/20 blur-3xl motion-safe:animate-pulseSoft"></div>
  <div class="pointer-events-none absolute right-0 top-10 -z-10 h-80 w-80 rounded-full bg-lime/18 blur-3xl motion-safe:animate-pulseSoft"></div>

  <Container class="relative space-y-12">
    <div class="grid items-center gap-10 lg:grid-cols-[1.1fr_0.9fr] lg:gap-14">
      <div>
        {eyebrow && (
          <p class="text-xs font-semibold uppercase tracking-[0.35em] text-aqua/85 motion-safe:animate-fadeUp">
            {eyebrow}
          </p>
        )}
        <h1 class="mt-5 font-display text-4xl leading-[1.02] sm:text-5xl lg:text-6xl motion-safe:animate-fadeUp" style="animation-delay: 70ms;">
          {title}
        </h1>
        <p class="mt-6 max-w-2xl text-lg text-mist motion-safe:animate-fadeUp" style="animation-delay: 140ms;">
          {subtitle}
        </p>

        <div class="mt-8 flex flex-wrap gap-3 motion-safe:animate-fadeUp" style="animation-delay: 210ms;">
          {primaryLabel && (
            <a class="btn-primary" href={primaryHref}>{primaryLabel}</a>
          )}
          {secondaryLabel && (
            <a class="btn-secondary" href={secondaryHref}>{secondaryLabel}</a>
          )}
        </div>

        {stats.length > 0 && (
          <div class="mt-10 grid gap-4 sm:grid-cols-3 motion-safe:animate-fadeUp" style="animation-delay: 280ms;">
            {stats.map((stat) => (
              <div class="glass-card rounded-2xl p-4">
                <p class="text-2xl font-semibold text-ice">{stat.value}</p>
                <p class="text-sm text-mist">{stat.label}</p>
              </div>
            ))}
          </div>
        )}
      </div>

      <div class="space-y-5">
        <div class="glass-card motion-safe:animate-float">
          <p class="text-xs uppercase tracking-[0.3em] text-aqua/90">{heroSide.eyebrow}</p>
          <p class="mt-4 font-display text-2xl font-semibold">{heroSide.title}</p>
          <p class="mt-3 text-sm text-mist">{heroSide.subtitle}</p>
          <div class="mt-5 flex flex-wrap gap-2">
            {heroSide.badges.map((badge) => (
              <span class="badge">{badge}</span>
            ))}
          </div>
        </div>
        <div class="grid gap-4 sm:grid-cols-2">
          {heroSide.cards.map((card) => (
            <div class="card p-5">
              <p class="text-xs uppercase tracking-[0.24em] text-mist">{card.label}</p>
              <p class="mt-2 text-lg font-semibold">{card.value}</p>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="rounded-3xl border border-white/12 bg-coal/55 p-4 sm:p-5">
      <p class="text-xs uppercase tracking-[0.28em] text-mist">
        {ecosystemLabel[lang] ?? ecosystemLabel.en}
      </p>
      <div class="mask-fade mt-4 overflow-hidden">
        <div class="marquee-track marquee-track-slower motion-safe:animate-marquee">
          {brandLoop.map((brand) => (
            <div class="inline-flex min-w-[160px] items-center gap-3 rounded-2xl border border-white/10 bg-white/5 px-4 py-3" style={`--brand:#${brand.icon.hex}`}>
              <svg viewBox="0 0 24 24" class="h-5 w-5 text-[var(--brand)]" fill="currentColor" aria-hidden="true">
                <path d={brand.icon.path}></path>
              </svg>
              <span class="text-sm text-ice/90">{brand.name}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
  </Container>
</section>

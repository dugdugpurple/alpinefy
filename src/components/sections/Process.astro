---
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';

const { lang = defaultLang } = Astro.props;
const { sections } = getCopy(lang);

const stepIcons = [
  'M12 6h.01M4 10a8 8 0 1 1 16 0v7H4v-7Z',
  'M4 20l6-2 8-8-4-4-8 8-2 6Z',
  'M5 15l7-12 7 12H5Zm7 6v-4',
  'M4 13h16M4 17h10',
];
---

<section class="py-20 sm:py-24" id="proces">
  <Container class="space-y-12">
    <SectionHeading
      eyebrow={sections.process.eyebrow}
      title={sections.process.title}
      subtitle={sections.process.subtitle}
    />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {sections.process.steps.map((step, index) => (
        <article class="card card-3d flex h-full flex-col">
          <div class="flex items-center justify-between">
            <span class="bg-gradient-to-br from-aqua to-lime bg-clip-text font-display text-5xl font-bold leading-none tracking-[-0.04em] text-transparent">
              0{index + 1}
            </span>
            <span class="inline-flex h-10 w-10 shrink-0 items-center justify-center rounded-2xl border border-aqua/20 bg-aqua/10 text-aqua">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d={stepIcons[index]}></path>
              </svg>
            </span>
          </div>
          <h3 class="mt-7 font-display text-xl font-semibold text-ice">{step.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-mist">{step.description}</p>
        </article>
      ))}
    </div>
  </Container>
</section>

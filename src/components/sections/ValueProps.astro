---
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';

const { lang = defaultLang } = Astro.props;
const { sections } = getCopy(lang);

const icons = [
  'M12 3v6l4-2M5 21h14',
  'M3 17l5-5 4 4 7-9',
  'M6 6h12M6 12h12M6 18h8',
  'M4 7h6v12H4zM14 3h6v16h-6z',
];
---

<section class="py-20 sm:py-24">
  <Container class="space-y-12">
    <SectionHeading
      eyebrow={sections.valueProps.eyebrow}
      title={sections.valueProps.title}
      subtitle={sections.valueProps.subtitle}
    />
    <div class="grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {sections.valueProps.items.map((item, index) => (
        <div class="card card-3d h-full">
          <span class="inline-flex h-11 w-11 items-center justify-center rounded-2xl border border-white/15 bg-white/8 text-aqua">
            <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d={icons[index]}></path>
            </svg>
          </span>
          <h3 class="mt-4 font-display text-xl">{item.title}</h3>
          <p class="mt-3 text-sm text-mist">{item.description}</p>
        </div>
      ))}
    </div>
  </Container>
</section>

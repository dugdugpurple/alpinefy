---
import Container from '../Container.astro';
import FdHeading from './FdHeading.astro';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';
import {
  getServiceAnchor,
  getServiceFunnelCopy,
  getServiceInquiryPath,
  getServiceKeyByIndex,
} from '../../data/services-funnel';
import { siShopify, siClaude } from 'simple-icons';

const { lang = defaultLang } = Astro.props;
const { sections } = getCopy(lang);
const services = sections.services;
const funnelCopy = getServiceFunnelCopy(lang);

// Per-service icons: line glyphs for the two generic services, brand marks for Shopify + Claude.
const serviceIcons = [
  { fill: false, inner: '<circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1.2" fill="currentColor" stroke="none"/>' },
  { fill: false, inner: '<path d="M4 21V8l6-4 6 4v13"/><path d="M2 21h20"/><path d="M9 21v-5h2v5"/><path d="M8 9h.5M13 9h.5M8 12.5h.5M13 12.5h.5"/>' },
  { fill: true, inner: `<path d="${siShopify.path}"/>` },
  { fill: true, inner: `<path d="${siClaude.path}"/>` },
];
---

<section class="relative py-20 sm:py-28" id="sluzby">
  <Container class="space-y-14">
    <FdHeading eyebrow={services.eyebrow} title={services.title} subtitle={services.subtitle} />

    <div class="grid gap-4 md:grid-cols-2">
      {services.items.map((service, index) => {
        const serviceKey = getServiceKeyByIndex(index);
        const anchor = getServiceAnchor(serviceKey);
        const highlights = funnelCopy.highlights[serviceKey] ?? [];
        const inquiryHref = getServiceInquiryPath(lang, serviceKey);
        return (
          <div class="relative">
            {anchor.aliases.map((alias) => (
              <span id={alias} class="pointer-events-none absolute -top-28 block h-0 w-0"></span>
            ))}
            <article
              id={anchor.id}
              class="fd-service-d group relative flex h-full scroll-mt-28 flex-col overflow-hidden rounded-3xl border border-white/10 bg-coal/50 p-8 transition duration-300"
            >
              <span class="fd-service-d-glow pointer-events-none absolute -right-16 -top-16 h-40 w-40 rounded-full opacity-0 blur-3xl transition-opacity duration-500"></span>

              <div class="relative flex items-start gap-4">
                <span class="inline-flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl border border-aqua/25 bg-aqua/10 text-aqua shadow-[0_10px_30px_-12px_rgba(38,202,255,0.7)]">
                  <svg
                    viewBox="0 0 24 24"
                    class="h-6 w-6"
                    fill={serviceIcons[index].fill ? 'currentColor' : 'none'}
                    stroke={serviceIcons[index].fill ? 'none' : 'currentColor'}
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    set:html={serviceIcons[index].inner}
                  ></svg>
                </span>
                <div>
                  <h3 class="font-display text-2xl font-bold tracking-[-0.02em] text-ice sm:text-[1.7rem]">{service.title}</h3>
                  <p class="mt-3 text-sm leading-relaxed text-mist">{service.description}</p>
                </div>
              </div>

              <div class="relative mt-6 flex flex-wrap gap-2">
                {service.tags.map((tag) => (
                  <span class="inline-flex items-center rounded-full border border-white/10 bg-white/[0.04] px-3 py-1 text-xs text-ice/75">{tag}</span>
                ))}
              </div>

              {highlights.length > 0 && (
                <ul class="relative mt-6 flex-1 space-y-3 border-t border-white/[0.07] pt-6">
                  {highlights.map((item) => (
                    <li class="flex items-start gap-3 text-sm leading-relaxed text-mist">
                      <span class="mt-1 inline-flex h-5 w-5 shrink-0 items-center justify-center rounded-md border border-aqua/25 bg-aqua/10 text-aqua">
                        <svg viewBox="0 0 24 24" class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                          <path d="M20 6 9 17l-5-5" />
                        </svg>
                      </span>
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}

              <div class="relative mt-7">
                <a class="btn-primary w-full sm:w-auto" href={inquiryHref}>{funnelCopy.servicesCardCta}</a>
              </div>
            </article>
          </div>
        );
      })}
    </div>
  </Container>
</section>

<style>
  .fd-service-d {
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .fd-service-d:hover {
    transform: translateY(-6px);
    border-color: rgba(var(--color-aqua) / 0.4);
    box-shadow: 0 0 0 1px rgba(var(--color-aqua) / 0.18), 0 34px 70px -34px rgba(0, 0, 0, 0.85);
  }
  .fd-service-d-glow {
    background: radial-gradient(circle, rgba(var(--color-aqua) / 0.5), transparent 70%);
  }
  .fd-service-d:hover .fd-service-d-glow {
    opacity: 0.4;
  }
  @media (prefers-reduced-motion: reduce) {
    .fd-service-d {
      transition: none !important;
      transform: none !important;
    }
  }
</style>

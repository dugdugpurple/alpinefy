---
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';
import {
  siAstro,
  siTailwindcss,
  siNetlify,
  siNextdotjs,
  siReact,
  siTypescript,
  siGoogleanalytics,
  siGoogletagmanager,
  siGooglesearchconsole,
  siShopify,
  siCursor,
  siCloudflare,
  siFigma,
  siGithub,
  siVercel,
} from 'simple-icons';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';

const { lang = defaultLang } = Astro.props;
const { sections } = getCopy(lang);
const msClarityIcon = {
  hex: '00A4EF',
  path: 'M4 4h7v7H4zm9 0h7v7h-7zM4 13h7v7H4zm9 0h7v7h-7z',
};

const partnerLogos = [
  { name: 'Astro', icon: siAstro },
  { name: 'Tailwind CSS', icon: siTailwindcss },
  { name: 'Netlify', icon: siNetlify },
  { name: 'Next.js', icon: siNextdotjs },
  { name: 'React', icon: siReact },
  { name: 'TypeScript', icon: siTypescript },
  { name: 'Shopify', icon: siShopify },
  { name: 'Google Analytics', icon: siGoogleanalytics },
  { name: 'Google Tag Manager', icon: siGoogletagmanager },
  { name: 'Search Console', icon: siGooglesearchconsole },
  { name: 'Microsoft Clarity', icon: msClarityIcon },
  { name: 'Cursor', icon: siCursor },
  { name: 'Cloudflare', icon: siCloudflare },
  { name: 'GitHub', icon: siGithub },
  { name: 'Vercel', icon: siVercel },
  { name: 'Figma', icon: siFigma },
];

const half = Math.ceil(partnerLogos.length / 2);
const rowOne = [...partnerLogos.slice(0, half), ...partnerLogos.slice(0, half)];
const rowTwo = [...partnerLogos.slice(half), ...partnerLogos.slice(half)];
---

<section class="py-16 sm:py-20">
  <Container class="space-y-10">
    <SectionHeading
      eyebrow={sections.partners.eyebrow}
      title={sections.partners.title}
      subtitle={sections.partners.subtitle}
    />
  </Container>

  <div class="mt-10 space-y-5 sm:mt-12 sm:space-y-6">
    <div class="mask-fade overflow-hidden">
      <div class="marquee-track marquee-track-interactive motion-safe:animate-marquee py-1">
        {rowOne.map((partner) => (
          <div class="group inline-flex select-none items-center gap-2.5 px-6 sm:px-8" style={`--brand:#${partner.icon.hex}`}>
            <svg viewBox="0 0 24 24" class="h-6 w-6 text-ice/38 transition duration-300 group-hover:text-[var(--brand)]" fill="currentColor" aria-hidden="true">
              <path d={partner.icon.path}></path>
            </svg>
            <span class="text-sm font-medium tracking-tight text-ice/40 transition duration-300 group-hover:text-ice">{partner.name}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="mask-fade overflow-hidden">
      <div class="marquee-track marquee-track-slower marquee-track-interactive motion-safe:animate-marquee py-1" style="animation-direction: reverse;">
        {rowTwo.map((partner) => (
          <div class="group inline-flex select-none items-center gap-2.5 px-6 sm:px-8" style={`--brand:#${partner.icon.hex}`}>
            <svg viewBox="0 0 24 24" class="h-6 w-6 text-ice/38 transition duration-300 group-hover:text-[var(--brand)]" fill="currentColor" aria-hidden="true">
              <path d={partner.icon.path}></path>
            </svg>
            <span class="text-sm font-medium tracking-tight text-ice/40 transition duration-300 group-hover:text-ice">{partner.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

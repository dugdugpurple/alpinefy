---
import Container from '../Container.astro';
import SectionHeading from '../SectionHeading.astro';
import {
  siAstro,
  siTailwindcss,
  siNetlify,
  siNextdotjs,
  siReact,
  siTypescript,
  siGoogleanalytics,
  siGoogletagmanager,
  siGooglesearchconsole,
  siShopify,
  siCursor,
  siCloudflare,
  siFigma,
  siGithub,
  siVercel,
} from 'simple-icons';
import { defaultLang } from '../../i18n/languages';
import { getCopy } from '../../i18n/copy';

const { lang = defaultLang } = Astro.props;
const { sections } = getCopy(lang);
const msClarityIcon = {
  hex: '00A4EF',
  path: 'M4 4h7v7H4zm9 0h7v7h-7zM4 13h7v7H4zm9 0h7v7h-7z',
};

const partnerLogos = [
  { name: 'Astro', icon: siAstro, type: 'stack', href: 'https://astro.build/' },
  { name: 'Tailwind CSS', icon: siTailwindcss, type: 'stack', href: 'https://tailwindcss.com/' },
  { name: 'Netlify', icon: siNetlify, type: 'stack', href: 'https://www.netlify.com/' },
  { name: 'Next.js', icon: siNextdotjs, type: 'stack', href: 'https://nextjs.org/' },
  { name: 'React', icon: siReact, type: 'stack', href: 'https://react.dev/' },
  { name: 'TypeScript', icon: siTypescript, type: 'stack', href: 'https://www.typescriptlang.org/' },
  { name: 'Shopify', icon: siShopify, type: 'stack', href: 'https://www.shopify.com/' },
  { name: 'Google Analytics', icon: siGoogleanalytics, type: 'analytics', href: 'https://analytics.google.com/' },
  { name: 'Google Tag Manager', icon: siGoogletagmanager, type: 'analytics', href: 'https://tagmanager.google.com/' },
  { name: 'Search Console', icon: siGooglesearchconsole, type: 'analytics', href: 'https://search.google.com/search-console' },
  { name: 'Microsoft Clarity', icon: msClarityIcon, type: 'analytics', href: 'https://clarity.microsoft.com/' },
  { name: 'Cursor', icon: siCursor, type: 'tools', href: 'https://www.cursor.com/' },
  { name: 'Cloudflare', icon: siCloudflare, type: 'tools', href: 'https://www.cloudflare.com/' },
  { name: 'GitHub', icon: siGithub, type: 'tools', href: 'https://github.com/' },
  { name: 'Vercel', icon: siVercel, type: 'tools', href: 'https://vercel.com/' },
  { name: 'Figma', icon: siFigma, type: 'tools', href: 'https://www.figma.com/' },
];

const typeLabels = {
  en: { stack: 'Stack', analytics: 'Analytics', tools: 'Tools' },
  de: { stack: 'Stack', analytics: 'Analytics', tools: 'Tools' },
  pl: { stack: 'Stack', analytics: 'Analityka', tools: 'Narzędzia' },
  cz: { stack: 'Stack', analytics: 'Analytika', tools: 'Nástroje' },
  sk: { stack: 'Stack', analytics: 'Analytika', tools: 'Nástroje' },
};

const labels = typeLabels[lang] ?? typeLabels.en;
---

<section class="py-16 sm:py-20">
  <Container class="space-y-10">
    <SectionHeading
      eyebrow={sections.partners.eyebrow}
      title={sections.partners.title}
      subtitle={sections.partners.subtitle}
    />

    <div class="rounded-3xl border border-white/12 bg-coal/55 p-4 sm:p-5">
      <div class="grid gap-4 grid-cols-2 sm:grid-cols-3 lg:grid-cols-4">
        {partnerLogos.map((partner) => (
          <div class="logo-card card-3d" style={`--brand:#${partner.icon.hex}`}>
            <svg viewBox="0 0 24 24" aria-hidden="true" class="h-8 w-8" fill="currentColor">
              <path d={partner.icon.path}></path>
            </svg>
            <div class="mt-3 text-center">
              <p class="text-sm font-semibold text-ice/88">{partner.name}</p>
              <p class="logo-type">{labels[partner.type]}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </Container>
</section>

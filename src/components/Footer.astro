---
import Container from './Container.astro';
import Logo from './Logo.astro';
import SocialIcons from './SocialIcons.astro';
import { attributionFieldNames } from '../data/contact-intake';
import { getDisplayPhone, getPhoneDialValue, site } from '../data/site';
import { defaultLang } from '../i18n/languages';
import { getCopy, navItems } from '../i18n/copy';
import { getLegalCopy } from '../i18n/legal';
import { getRoutePath } from '../i18n/routes';

const year = new Date().getFullYear();
const { lang = defaultLang } = Astro.props;
const copy = getCopy(lang);
const legal = getLegalCopy(lang);

const stacks = ['Web strategy', 'SEO', 'Performance', 'Analytics', 'Automation & AI'];

const newsletterCopy = {
  en: {
    title: 'Newsletter',
    subtitle: 'Practical web growth insights. No spam.',
    placeholder: 'Your email',
    cta: 'Subscribe',
    consent: '1-2 emails monthly.',
    success: 'Subscribed. First update will arrive soon.',
    error: 'Subscription failed. Please try again.',
  },
  de: {
    title: 'Newsletter',
    subtitle: 'Praktische Web-Growth Insights. Kein Spam.',
    placeholder: 'Ihre E-Mail',
    cta: 'Abonnieren',
    consent: '1-2 E-Mails pro Monat.',
    success: 'Abonniert. Das erste Update kommt bald.',
    error: 'Anmeldung fehlgeschlagen. Bitte erneut versuchen.',
  },
  pl: {
    title: 'Newsletter',
    subtitle: 'Praktyczne wskazówki growth. Bez spamu.',
    placeholder: 'Twój e-mail',
    cta: 'Subskrybuj',
    consent: '1-2 maile miesięcznie.',
    success: 'Subskrypcja aktywna. Pierwszy e-mail wkrótce.',
    error: 'Nie udało się zapisać. Spróbuj ponownie.',
  },
  cz: {
    title: 'Newsletter',
    subtitle: 'Praktické growth tipy. Bez spamu.',
    placeholder: 'Váš e-mail',
    cta: 'Odebírat',
    consent: '1-2 e-maily měsíčně.',
    success: 'Odběr potvrzen. První e-mail dorazí brzy.',
    error: 'Odeslání se nepodařilo. Zkuste to znovu.',
  },
  sk: {
    title: 'Newsletter',
    subtitle: 'Praktické tipy pre rast webu. Bez spamu.',
    placeholder: 'Váš e-mail',
    cta: 'Odoberať',
    consent: '1-2 e-maily mesačne.',
    success: 'Odber je aktívny. Prvý e-mail príde čoskoro.',
    error: 'Nepodarilo sa odoslať. Skúste to znova.',
  },
};

const contactNoteCopy = {
  en: 'During business days, we reply within 24 hours.',
  de: 'An Werktagen antworten wir innerhalb von 24 Stunden.',
  pl: 'W dni robocze odpowiadamy w ciągu 24 godzin.',
  cz: 'V pracovních dnech odpovídáme do 24 hodin.',
  sk: 'Počas pracovných dní odpovedáme do 24 hodín.',
};

const newsletter = newsletterCopy[lang] ?? newsletterCopy.en;
const contactNote = contactNoteCopy[lang] ?? contactNoteCopy.en;
const newsletterFormName = 'newsletter-signup';
const currentPath = Astro.url.pathname;
const phoneLabel = getDisplayPhone(lang);
const phoneDial = getPhoneDialValue();
const careerLabelByLang = {
  en: 'Career',
  de: 'Karriere',
  pl: 'Kariera',
  cz: 'Kariéra',
  sk: 'Kariéra',
};
const careerLabel = careerLabelByLang[lang] ?? careerLabelByLang.en;
---

<footer class="relative border-t border-white/10 bg-coal/55">
  <div class="pointer-events-none absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-aqua/55 to-transparent"></div>
  <Container class="relative py-14 sm:py-16">
    <div class="grid items-start gap-12 xl:grid-cols-[1.25fr_0.75fr_1fr] xl:gap-10">
      <div class="space-y-6">
        <div class="flex items-center gap-3">
          <span class="logo-mark inline-flex h-11 w-11 items-center justify-center rounded-2xl">
            <Logo class="h-6 w-6" />
          </span>
          <div>
            <p class="font-display text-xl">{site.name}</p>
            <p class="text-[11px] uppercase tracking-[0.25em] text-mist/85">AI & Web Studio</p>
          </div>
        </div>

        <p class="max-w-md text-sm text-mist">{copy.site.description}</p>

        <div class="flex flex-wrap gap-2">
          {stacks.map((item) => (
            <span class="tag">{item}</span>
          ))}
        </div>

        <div class="space-y-3 text-sm text-mist">
          <div class="grid gap-3 sm:grid-cols-2">
            <a
              class="group inline-flex items-center gap-2.5 rounded-2xl border border-white/12 bg-white/5 px-4 py-3 text-ice/90 transition hover:border-aqua/35 hover:bg-white/8 hover:text-ice"
              href={`tel:${phoneDial}`}
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 text-aqua/85" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M22 16.9v3a2 2 0 0 1-2.2 2 19.9 19.9 0 0 1-8.7-3.1A19.6 19.6 0 0 1 5 12.9a19.9 19.9 0 0 1-3.1-8.7A2 2 0 0 1 3.9 2h3a2 2 0 0 1 2 1.7c.1.9.3 1.8.6 2.7a2 2 0 0 1-.4 2l-1.3 1.3a16 16 0 0 0 6.3 6.3l1.3-1.3a2 2 0 0 1 2-.4c.9.3 1.8.5 2.7.6A2 2 0 0 1 22 16.9z"></path>
              </svg>
              <span class="font-medium text-ice/95">{phoneLabel}</span>
            </a>
            <a
              class="group inline-flex items-center gap-2.5 rounded-2xl border border-white/12 bg-white/5 px-4 py-3 text-ice/90 transition hover:border-aqua/35 hover:bg-white/8 hover:text-ice"
              href={`mailto:${site.email}`}
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4 text-aqua/85" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16v12H4z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" d="m4 8 8 6 8-6"></path>
              </svg>
              <span class="font-medium text-ice/95">{site.email}</span>
            </a>
          </div>
          <p class="inline-flex items-center gap-2.5">
            <svg viewBox="0 0 24 24" class="h-4 w-4 text-aqua/85" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M12 21s7-6.2 7-11a7 7 0 1 0-14 0c0 4.8 7 11 7 11z"></path>
              <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
            {site.address}
          </p>
          <p class="text-xs text-mist/80">{contactNote}</p>
        </div>
      </div>

      <nav class="space-y-4 text-sm xl:justify-self-center xl:self-center xl:text-center" aria-label={copy.footer.navigation}>
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-aqua/90">{copy.footer.navigation}</p>
        <div class="grid gap-2 xl:justify-items-center">
          {navItems.map((link) => (
            <a class="text-mist transition hover:text-ice" href={getRoutePath(link.route, lang)}>
              {copy.nav[link.key]}
            </a>
          ))}
        </div>
      </nav>

      <div class="space-y-4 text-sm xl:justify-self-end xl:max-w-sm">
        <p class="text-xs font-semibold uppercase tracking-[0.25em] text-aqua/90">{copy.footer.socials}</p>
        <SocialIcons lang={lang} />
        <div class="card rounded-2xl p-4" data-newsletter-card>
          <p class="text-xs font-semibold uppercase tracking-[0.24em] text-aqua/90">{newsletter.title}</p>
          <p class="mt-2 text-xs text-mist">{newsletter.subtitle}</p>
          <form
            class="mt-3 grid gap-2 sm:grid-cols-[1fr_auto]"
            name={newsletterFormName}
            method="POST"
            netlify
            netlify-honeypot="bot-field"
            data-netlify="true"
            data-netlify-honeypot="bot-field"
            data-newsletter-form
            data-capture-attribution="true"
            data-endpoint="/"
            data-success={newsletter.success}
            data-error={newsletter.error}
            action={`${getRoutePath('thankYou', lang)}?src=newsletter&lang=${lang}`}
          >
            <input type="hidden" name="form-name" value={newsletterFormName} />
            <p class="hidden">
              <label>
                Don’t fill this out if you’re human: <input name="bot-field" />
              </label>
            </p>
            <input type="hidden" name="recipient" value={site.email} />
            <input type="hidden" name="subject" value="New newsletter subscription" />
            <input type="hidden" name="locale" value={lang} />
            <input type="hidden" name="source_page" value={currentPath} />
            {attributionFieldNames.map((field) => (
              <input type="hidden" name={field} value="" data-attribution-field={field} />
            ))}
            <label class="sr-only" for={`newsletter-email-${lang}`}>{newsletter.title}</label>
            <input
              id={`newsletter-email-${lang}`}
              class="input-field min-h-10 py-2.5 text-xs"
              name="email"
              type="email"
              placeholder={newsletter.placeholder}
              required
            />
            <button class="btn-primary min-h-10 px-4 py-2 text-xs" type="submit">{newsletter.cta}</button>
          </form>
          <p
            class="mt-2 hidden rounded-xl border border-aqua/35 bg-aqua/10 px-3 py-2 text-xs text-aqua"
            data-newsletter-popup
            role="status"
            aria-live="polite"
          ></p>
          <p class="mt-2 text-[11px] text-mist/80">{newsletter.consent}</p>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-3 border-t border-white/10 pt-6 text-xs text-mist/75 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} {site.name}. {copy.footer.rights}</p>
      <div class="flex flex-wrap items-center gap-4">
        <a class="text-mist/75 transition hover:text-ice" href={getRoutePath('contact', lang)}>
          {copy.nav.contact}
        </a>
        <a class="text-mist/75 transition hover:text-ice" href={getRoutePath('career', lang)}>
          {careerLabel}
        </a>
        <a class="text-mist/75 transition hover:text-ice" href={getRoutePath('privacy', lang)}>
          {legal.footer.privacy}
        </a>
        <a class="text-mist/75 transition hover:text-ice" href={getRoutePath('cookies', lang)}>
          {legal.footer.cookies}
        </a>
      </div>
    </div>
  </Container>
</footer>

<script is:inline>
  const initNewsletterForms = () => {
    const forms = document.querySelectorAll('[data-newsletter-form]');

    forms.forEach((form) => {
      if (form.dataset.ready === 'true') return;
      form.dataset.ready = 'true';

      const card = form.closest('[data-newsletter-card]');
      const popup = card?.querySelector('[data-newsletter-popup]');
      const submitButton = form.querySelector('button[type="submit"]');
      let popupTimeout;

      const showPopup = (message, isError = false) => {
        if (!popup) return;
        popup.textContent = message;
        popup.classList.remove('hidden', 'border-red-300/40', 'bg-red-500/10', 'text-red-100');
        if (isError) {
          popup.classList.add('border-red-300/40', 'bg-red-500/10', 'text-red-100');
        }

        if (popupTimeout) clearTimeout(popupTimeout);
        popupTimeout = window.setTimeout(() => {
          popup.classList.add('hidden');
        }, 4600);
      };

      form.addEventListener('submit', async (event) => {
        event.preventDefault();

        const endpoint = form.dataset.endpoint || '/';
        const successMessage = form.dataset.success || 'Done.';
        const errorMessage = form.dataset.error || 'Try again.';
        const formData = new FormData(form);
        const body = new URLSearchParams();

        formData.forEach((value, key) => {
          if (typeof value === 'string') body.append(key, value);
        });

        const originalLabel = submitButton?.textContent ?? '';
        if (submitButton) {
          submitButton.setAttribute('disabled', 'true');
          submitButton.textContent = '...';
        }

        try {
          const response = await fetch(endpoint, {
            method: 'POST',
            headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
            body: body.toString(),
          });

          if (!response.ok) throw new Error(`Newsletter submit failed: ${response.status}`);

          form.reset();
          window.dataLayer = window.dataLayer || [];
          window.dataLayer.push({
            event: 'newsletter_signup_success',
            form_name: form.getAttribute('name') || 'newsletter-signup',
            page_path: window.location.pathname,
            page_language: document.documentElement.lang || 'en',
          });
          showPopup(successMessage);
        } catch (error) {
          try {
            HTMLFormElement.prototype.submit.call(form);
            return;
          } catch {
            showPopup(errorMessage, true);
          }
        } finally {
          if (submitButton) {
            submitButton.removeAttribute('disabled');
            submitButton.textContent = originalLabel;
          }
        }
      });
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNewsletterForms);
  } else {
    initNewsletterForms();
  }

  document.addEventListener('astro:page-load', initNewsletterForms);
</script>

---
import {
  siThreads,
  siInstagram,
  siGithub,
} from 'simple-icons';
import { getSocials } from '../data/site';
import { defaultLang, type Lang } from '../i18n/languages';

const { class: className = '', lang = defaultLang } = Astro.props as {
  class?: string;
  lang?: Lang;
};

const linkedinIcon = {
  hex: '0A66C2',
  path: 'M4.983 3.5C4.983 4.881 3.87 6 2.5 6S0 4.881 0 3.5 1.11 1 2.5 1s2.483 1.119 2.483 2.5zM.5 8h4V23h-4V8zm7 0h3.8v2.05h.05c.53-1 1.82-2.05 3.75-2.05 4.01 0 4.75 2.64 4.75 6.07V23h-4v-7.75c0-1.85-.03-4.23-2.58-4.23-2.58 0-2.97 2.01-2.97 4.09V23h-4V8z',
};

const iconMap = {
  LinkedIn: linkedinIcon,
  Threads: siThreads,
  Instagram: siInstagram,
  GitHub: siGithub,
};

const socials = getSocials(lang).map((item) => ({
  ...item,
  icon: iconMap[item.label],
}));
---

<div class={`flex flex-wrap items-center gap-2.5 ${className}`}>
  {socials.map((item) => (
    <a
      class="social-icon"
      href={item.href}
      target="_blank"
      rel="noreferrer"
      aria-label={item.label}
      style={`--brand: #${item.icon.hex}`}
    >
      <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
        <path d={item.icon.path}></path>
      </svg>
    </a>
  ))}
</div>

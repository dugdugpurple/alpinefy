---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { site, getSocials } from '../data/site';
import { languages, defaultLang, getLangTag } from '../i18n/languages';
import { getCopy } from '../i18n/copy';
import { localizePath, normalizePath } from '../i18n/utils';

const {
  title,
  description,
  canonical,
  image,
  imageAlt = site.name,
  imageWidth = 1200,
  imageHeight = 630,
  imageType = 'image/png',
  lang = defaultLang,
  type = 'website',
  publishedTime,
  modifiedTime,
  keywords,
  noindex = false,
  structuredData,
} = Astro.props;

const copy = getCopy(lang);
const localizedOgImageMap: Record<string, string> = {
  en: '/og-image-en.png',
  de: '/og-image-de.png',
  pl: '/og-image-pl.png',
  cz: '/og-image-cz.png',
  sk: '/og-image-sk.png',
};
const defaultOgImage = localizedOgImageMap[lang] ?? localizedOgImageMap[defaultLang];
const selectedImage = image ?? defaultOgImage;
const pageTitle = title ? `${title} | ${site.name}` : `${copy.site.tagline} | ${site.name}`;
const metaDescription = description ?? copy.site.description;
const basePath = normalizePath(Astro.url.pathname);
const canonicalUrl = canonical
  ? canonical.startsWith('http')
    ? canonical
    : `${site.url}${canonical}`
  : `${site.url}${localizePath(basePath, lang)}`;
const ogImage = selectedImage.startsWith('http') ? selectedImage : `${site.url}${selectedImage}`;
const langTag = getLangTag(lang);
const alternates = languages.map((item) => ({
  href: `${site.url}${localizePath(basePath, item.code)}`,
  hreflang: item.hreflang,
}));
const xDefault = `${site.url}${localizePath(basePath, defaultLang)}`;
const robotsContent = noindex
  ? 'noindex, nofollow'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';

const ahrefsVerification = import.meta.env.PUBLIC_AHREFS_VERIFICATION?.trim?.() ?? '';

const defaultKeywords: Record<string, string> = {
  en: 'web development, shopify e-commerce, seo optimization, performance websites, dach web agency',
  de: 'webentwicklung, shopify e-commerce, seo optimierung, performance websites, dach webagentur',
  pl: 'tworzenie stron, shopify e-commerce, seo, wydajne strony, agencja dla dach',
  cz: 'tvorba webu, shopify e-commerce, seo optimalizace, vykonne weby, dach agentura',
  sk: 'tvorba webu, shopify e-commerce, seo optimalizacia, vykonne weby, dach agentura',
};

const keywordContent = Array.isArray(keywords)
  ? keywords.filter(Boolean).join(', ')
  : typeof keywords === 'string' && keywords.trim()
    ? keywords
    : defaultKeywords[lang] ?? defaultKeywords.en;

const ogLocaleMap: Record<string, string> = {
  en: 'en_US',
  de: 'de_DE',
  pl: 'pl_PL',
  cz: 'cs_CZ',
  sk: 'sk_SK',
};
const ogLocale = ogLocaleMap[lang] ?? 'en_US';
const ogAlternateLocales = [
  ...new Set(
    languages
      .map((item) => ogLocaleMap[item.code])
      .filter((locale) => locale && locale !== ogLocale)
  ),
];

const geoRegionMap: Record<string, string> = {
  en: 'EU',
  de: 'DE',
  pl: 'PL',
  cz: 'CZ',
  sk: 'SK',
};
const geoRegion = geoRegionMap[lang] ?? 'EU';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: site.url,
  email: site.email,
  telephone: site.phoneIntl,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address,
  },
  sameAs: getSocials(lang).map((social) => social.href),
};

const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: site.name,
  url: site.url,
  inLanguage: langTag,
};

const pageSchema = {
  '@context': 'https://schema.org',
  '@type': type === 'article' ? 'Article' : 'WebPage',
  name: pageTitle,
  description: metaDescription,
  url: canonicalUrl,
  inLanguage: langTag,
  ...(publishedTime ? { datePublished: publishedTime } : {}),
  ...(modifiedTime ? { dateModified: modifiedTime } : {}),
  ...(type === 'article'
    ? {
        author: { '@type': 'Organization', name: site.name },
        publisher: { '@type': 'Organization', name: site.name },
      }
    : {}),
};

const externalSchema = structuredData
  ? (Array.isArray(structuredData) ? structuredData : [structuredData])
  : [];
const allStructuredData = [organizationSchema, websiteSchema, pageSchema, ...externalSchema];
---

<!doctype html>
<html lang={langTag}>
  <head>
    <meta charset="utf-8" />
    <script is:inline>
      (() => {
        const GTM_ID = 'GTM-PMG86FBV';
        const STORAGE_KEY = 'alpinefy_cookie_consent_v1';
        const CONSENT_EVENT = 'alpinefy:consent:update';

        window.dataLayer = window.dataLayer || [];
        window.gtag =
          window.gtag ||
          function() {
            window.dataLayer.push(arguments);
          };

        const deniedConsent = {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          personalization_storage: 'denied',
          functionality_storage: 'granted',
          security_storage: 'granted',
        };

        const grantedConsent = {
          ...deniedConsent,
          analytics_storage: 'granted',
        };
        let activeConsent = deniedConsent;

        window.gtag('consent', 'default', {
          ...deniedConsent,
          wait_for_update: 600,
        });

        let gtmLoaded = false;
        const loadGtm = () => {
          if (gtmLoaded) return;
          gtmLoaded = true;

          window.dataLayer = [];
          window.gtag('consent', 'default', {
            ...deniedConsent,
            wait_for_update: 600,
          });
          window.gtag('consent', 'update', activeConsent);
          window.dataLayer.push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
          const firstScript = document.getElementsByTagName('script')[0];
          const gtmScript = document.createElement('script');
          gtmScript.async = true;
          gtmScript.src = `https://www.googletagmanager.com/gtm.js?id=${GTM_ID}`;
          firstScript?.parentNode?.insertBefore(gtmScript, firstScript);
        };

        const applyConsent = (analyticsGranted, source) => {
          const consentState = analyticsGranted ? grantedConsent : deniedConsent;
          activeConsent = consentState;
          window.gtag('consent', 'update', consentState);
          window.dataLayer.push({
            event: 'cookie_consent_update',
            consent_analytics: analyticsGranted ? 'granted' : 'denied',
            consent_source: source || 'system',
          });
          document.documentElement.dataset.analyticsConsent = analyticsGranted ? 'granted' : 'denied';

          if (analyticsGranted) loadGtm();
        };

        const readStoredConsent = () => {
          try {
            const raw = localStorage.getItem(STORAGE_KEY);
            if (!raw) return null;
            const parsed = JSON.parse(raw);
            return typeof parsed?.analytics === 'boolean' ? parsed.analytics : null;
          } catch {
            return null;
          }
        };

        const storedConsent = readStoredConsent();
        if (storedConsent === true) applyConsent(true, 'stored');
        if (storedConsent === false) applyConsent(false, 'stored');

        document.addEventListener(CONSENT_EVENT, (event) => {
          const detail = event && typeof event === 'object' ? event.detail : null;
          if (!detail || typeof detail.analytics !== 'boolean') return;
          applyConsent(detail.analytics, detail.source || 'banner');
        });
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <script is:inline>
      (() => {
        const stored = localStorage.getItem('theme');
        const theme = stored === 'light' || stored === 'dark' ? stored : 'dark';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <meta name="description" content={metaDescription} />
    <meta name="keywords" content={keywordContent} />
    <meta name="author" content={site.name} />
    <meta name="robots" content={robotsContent} />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="format-detection" content="telephone=no, email=no, address=no" />
    <meta name="distribution" content="global" />
    <meta name="geo.region" content={geoRegion} />
    <meta name="geo.placename" content={site.address} />
    {ahrefsVerification && <meta name="ahrefs-site-verification" content={ahrefsVerification} />}
    <link rel="canonical" href={canonicalUrl} />
    <link rel="sitemap" type="application/xml" href={`${site.url}/sitemap-index.xml`} />
    <meta name="theme-color" content="#040E1B" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:type" content={type === 'article' ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:secure_url" content={ogImage} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:alt" content={imageAlt} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    <meta property="og:locale" content={ogLocale} />
    {ogAlternateLocales.map((locale) => (
      <meta property="og:locale:alternate" content={locale} />
    ))}
    {publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {(modifiedTime ?? publishedTime) && (
      <meta property="article:modified_time" content={modifiedTime ?? publishedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="twitter:url" content={canonicalUrl} />
    {allStructuredData.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={alt.hreflang} href={alt.href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefault} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg?v=20260721" />
    <link rel="icon" href="/favicon.ico?v=20260721" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png?v=20260721" />
  </head>
  <body class="bg-night text-ice antialiased">
    <div class="min-h-screen bg-radial-glow">
      <Header lang={lang} />
      <main id="content">
        <slot />
      </main>
      <Footer lang={lang} />
      <CookieBanner lang={lang} />
    </div>
    <script is:inline>
      (() => {
        const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!canHover || reduce) return;
        const HALF = 180;
        const initSpotlights = () => {
          document.querySelectorAll('[data-spotlight]').forEach((card) => {
            if (card.dataset.spotReady === 'true') return;
            card.dataset.spotReady = 'true';
            const mist = card.querySelector('.card-mist');
            if (!mist) return;
            let tx = 0, ty = 0, cx = 0, cy = 0, raf = 0, on = false;
            const setTarget = (e) => {
              const r = card.getBoundingClientRect();
              tx = e.clientX - r.left - HALF;
              ty = e.clientY - r.top - HALF;
            };
            const loop = () => {
              cx += (tx - cx) * 0.16;
              cy += (ty - cy) * 0.16;
              mist.style.transform = `translate3d(${cx.toFixed(2)}px, ${cy.toFixed(2)}px, 0)`;
              if (on) raf = requestAnimationFrame(loop);
            };
            card.addEventListener('mouseenter', (e) => {
              const r = card.getBoundingClientRect();
              tx = cx = e.clientX - r.left - HALF;
              ty = cy = e.clientY - r.top - HALF;
              mist.style.transform = `translate3d(${cx.toFixed(2)}px, ${cy.toFixed(2)}px, 0)`;
              on = true;
              card.classList.add('mist-on');
              cancelAnimationFrame(raf);
              raf = requestAnimationFrame(loop);
            });
            card.addEventListener('mousemove', setTarget);
            card.addEventListener('mouseleave', () => {
              on = false;
              cancelAnimationFrame(raf);
              card.classList.remove('mist-on');
            });
          });
        };
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initSpotlights);
        } else {
          initSpotlights();
        }
        document.addEventListener('astro:page-load', initSpotlights);
      })();
    </script>
    <script is:inline>
      const initThemeToggle = () => {
        const root = document.documentElement;
        if (root.dataset.themeToggleReady === 'true') return;
        root.dataset.themeToggleReady = 'true';

        document.addEventListener('click', (event) => {
          const button = event.target.closest('[data-theme-toggle]');
          if (!button) return;
          const current = root.dataset.theme === 'light' ? 'light' : 'dark';
          const next = current === 'light' ? 'dark' : 'light';
          root.dataset.theme = next;
          localStorage.setItem('theme', next);
        });
      };

      const initAttributionCapture = () => {
        const forms = document.querySelectorAll('form[data-capture-attribution="true"]');
        if (!forms.length) return;

        const SESSION_KEY = 'alpinefy_attribution_v1';
        const params = new URLSearchParams(window.location.search);
        const paramValue = (key) => (params.get(key) || '').trim();
        const hasNewAttribution =
          Boolean(paramValue('utm_source')) ||
          Boolean(paramValue('utm_medium')) ||
          Boolean(paramValue('utm_campaign')) ||
          Boolean(paramValue('utm_term')) ||
          Boolean(paramValue('utm_content')) ||
          Boolean(paramValue('gclid')) ||
          Boolean(paramValue('fbclid')) ||
          Boolean(paramValue('msclkid'));

        const currentAttribution = {
          utm_source: paramValue('utm_source'),
          utm_medium: paramValue('utm_medium'),
          utm_campaign: paramValue('utm_campaign'),
          utm_term: paramValue('utm_term'),
          utm_content: paramValue('utm_content'),
          gclid: paramValue('gclid'),
          fbclid: paramValue('fbclid'),
          msclkid: paramValue('msclkid'),
          landing_page: `${window.location.pathname}${window.location.search}`,
          referrer: document.referrer || '',
        };

        let stored = null;
        try {
          const raw = sessionStorage.getItem(SESSION_KEY);
          stored = raw ? JSON.parse(raw) : null;
        } catch {
          stored = null;
        }

        let resolved = stored && typeof stored === 'object' ? { ...stored } : null;

        if (!resolved || hasNewAttribution) {
          resolved = {
            ...(resolved || {}),
            ...currentAttribution,
            referrer: currentAttribution.referrer || resolved?.referrer || '',
            landing_page: resolved?.landing_page || currentAttribution.landing_page,
          };
          try {
            sessionStorage.setItem(SESSION_KEY, JSON.stringify(resolved));
          } catch {
            // no-op
          }
        }

        const finalValues = resolved || currentAttribution;

        forms.forEach((form) => {
          Object.entries(finalValues).forEach(([key, value]) => {
            const input = form.querySelector(`[data-attribution-field="${key}"]`);
            if (!(input instanceof HTMLInputElement)) return;
            if (input.value) return;
            input.value = typeof value === 'string' ? value : '';
          });
        });
      };

      const initContactIntentTracking = () => {
        const forms = document.querySelectorAll('form[name="contact-inquiry"]');
        if (!forms.length) return;

        forms.forEach((form) => {
          if (!(form instanceof HTMLFormElement)) return;
          if (form.dataset.intentTrackingReady === 'true') return;
          form.dataset.intentTrackingReady = 'true';

          form.addEventListener('submit', () => {
            const getValue = (field) => {
              const input = form.elements.namedItem(field);
              if (!input) return '';
              if (input instanceof HTMLInputElement || input instanceof HTMLSelectElement) {
                return (input.value || '').trim();
              }
              return '';
            };

            window.dataLayer = window.dataLayer || [];
            window.dataLayer.push({
              event: 'contact_form_intent_submit',
              page_path: window.location.pathname,
              page_language: document.documentElement.lang || 'en',
              service_interest: getValue('service_interest'),
              budget_range: getValue('budget_range'),
              timeline_preference: getValue('timeline_preference'),
            });
          });
        });
      };

      const initBase = () => {
        initThemeToggle();
        initAttributionCapture();
        initContactIntentTracking();
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initBase);
      } else {
        initBase();
      }

      document.addEventListener('astro:page-load', initBase);
    </script>
  </body>
</html>
